     1	//! The provider interface.
     2	//!
     3	//! A provider turns a `CompletionRequest` into a stream of `StreamEvent`. The
     4	//! core owns the trait. Each provider crate implements it.
     5	
     6	use crate::{CancelToken, Message, ProviderError, StreamEvent, ToolKind};
     7	use async_trait::async_trait;
     8	use futures::Stream;
     9	use serde::{Deserialize, Serialize};
    10	use std::pin::Pin;
    11	
    12	/// A boxed, sendable stream of normalised events.
    13	pub type ProviderStream = Pin<Box<dyn Stream<Item = Result<StreamEvent, ProviderError>> + Send>>;
    14	
    15	/// One tool, as advertised to the model.
    16	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
    17	pub struct ToolSpec {
    18	    pub name: String,
    19	    pub description: String,
    20	    /// The ACP tool category. See `ToolKind` in `SPEC-tool-interface`.
    21	    pub kind: ToolKind,
    22	    /// A JSON Schema object for the tool arguments.
    23	    pub input_schema: serde_json::Value,
    24	}
    25	
    26	/// One inference request.
    27	#[derive(Clone, Debug, Serialize, Deserialize)]
    28	pub struct CompletionRequest {
    29	    /// The provider-specific model id or ARN.
    30	    pub model: String,
    31	    /// The system prompt. Part of the stable prefix.
    32	    pub system: Option<String>,
    33	    /// The full conversation, oldest first.
    34	    pub messages: Vec<Message>,
    35	    /// The full tool list. Fixed for the session. Part of the stable prefix.
    36	    pub tools: Vec<ToolSpec>,
    37	    pub max_tokens: Option<u32>,
    38	    pub temperature: Option<f32>,
    39	    /// How hard the model should think. `None` means the provider's own default, so the
    40	    /// provider sends no field. See `SPEC-reasoning-across-providers` section 9.
    41	    pub reasoning: Option<crate::ReasoningEffort>,
    42	}
    43	
    44	#[async_trait]
    45	pub trait Provider: Send + Sync {
    46	    /// A stable id, for example `openrouter`, `bedrock`, or `azure`.
    47	    fn id(&self) -> &str;
    48	
    49	    /// Start a streaming completion. The future resolves once the response
    50	    /// headers arrive. The stream then yields events. The provider must select
    51	    /// against `cancel.cancelled()` and stop the request when it fires.
    52	    async fn stream(
    53	        &self,
    54	        request: CompletionRequest,
    55	        cancel: CancelToken,
    56	    ) -> Result<ProviderStream, ProviderError>;
    57	}
     1	//! The agent loop.
     2	//!
     3	//! The loop drives one full run. A run may span several provider turns because a
     4	//! turn can call tools. The loop appends every message to the `Context`. It
     5	//! emits an `AgentEvent` stream. A frontend renders the stream.
     6	
     7	use crate::{
     8	    ApprovalDecision, ApprovalPolicy, CancelToken, ContentBlock, Message, Role, SandboxMode,
     9	};
    10	use crate::{
    11	    CompletionRequest, Context, Error, HookChain, HookOutcome, Provider, StopReason, StreamEvent,
    12	    ToolCallView, ToolContext, ToolError, ToolKind, ToolOutput, ToolRegistry,
    13	};
    14	use futures::Stream;
    15	use futures::StreamExt;
    16	use serde::{Deserialize, Serialize};
    17	use std::path::PathBuf;
    18	use std::pin::Pin;
    19	use std::sync::Arc;
    20	use std::task::{Context as TaskContext, Poll};
    21	
    22	/// Why a full agent run stopped. The wire names match the ACP `StopReason` set,
    23	/// so `rho-acp` maps the values one-to-one onto a `session/prompt` response.
    24	/// See SPEC-acp.
    25	///
    26	/// One name needs an explicit rename. ACP spells the cancelled reason with two
    27	/// letters `l`, as `cancelled`. Rust names the variant `Canceled` with one `l`,
    28	/// which `rename_all = "snake_case"` would turn into `canceled`. That value is
    29	/// not valid in ACP. The `serde(rename)` attribute below corrects it. Do not
    30	/// remove the attribute.
    31	#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
    32	#[serde(rename_all = "snake_case")]
    33	pub enum AgentStopReason {
    34	    /// The model finished and asked for no more tools.
    35	    EndTurn,
    36	    /// A turn hit the token limit.
    37	    MaxTokens,
    38	    /// The loop hit its per-run turn cap. See section 9.
    39	    MaxTurnRequests,
    40	    /// The model refused, or a content filter stopped the output.
    41	    Refusal,
    42	    /// The caller cancelled the run. The wire value is `cancelled`.
    43	    #[serde(rename = "cancelled")]
    44	    Canceled,
    45	}
    46	
    47	#[derive(Clone, Debug, PartialEq)]
    48	pub enum AgentEvent {
    49	    /// One provider turn begins.
    50	    TurnStart,
    51	    /// A normalised provider event.
    52	    Stream(StreamEvent),
    53	    /// A tool begins execution, after hooks and the approval policy pass.
    54	    ToolStart {
    55	        id: String,
    56	        name: String,
    57	        kind: ToolKind,
    58	    },
    59	    /// A streamed line of tool output.
    60	    ToolUpdate { id: String, output: String },
    61	    /// A tool finished. The output feeds the next turn.
    62	    ToolEnd { id: String, output: ToolOutput },
    63	    /// One provider turn ended.
    64	    TurnEnd { stop_reason: StopReason },
    65	    /// A background task started.
    66	    TaskStart {
    67	        id: crate::TaskId,
    68	        command: String,
    69	        reason: crate::BackgroundReason,
    70	    },
    71	    /// A task reported progress.
    72	    TaskProgressed {
    73	        id: crate::TaskId,
    74	        progress: crate::TaskProgress,
    75	    },
    76	    /// A task reached a final state. Always emitted, success or failure.
    77	    TaskEnd {
    78	        id: crate::TaskId,
    79	        state: crate::TaskState,
    80	        output_tail: String,
    81	    },
    82	    /// The run is fully settled. No further turn will run.
    83	    AgentEnd { stop_reason: AgentStopReason },
    84	    /// A subagent was spawned under this session. See SPEC-subagents section 9.
    85	    ///
    86	    /// These variants are new, not reused `TaskStart` ones. A task is an
    87	    /// operating-system command with an exit code. An agent has turns, token
    88	    /// usage, and a summary. Sharing one variant would force a frontend to guess
    89	    /// which it held.
    90	    AgentSpawned {
    91	        id: crate::AgentId,
    92	        agent: String,
    93	        depth: u32,
    94	    },
    95	    /// A subagent reported progress: its turn count and summed usage so far.
    96	    AgentProgressed {
    97	        id: crate::AgentId,
    98	        turns: u32,
    99	        usage: crate::Usage,
   100	    },
   101	    /// A subagent finished. The report carries the summary, not the transcript.
   102	    AgentFinished {
   103	        id: crate::AgentId,
   104	        report: crate::AgentReport,
   105	    },
   106	}
