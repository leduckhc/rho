   138	impl From<DiskBlock> for ContentBlock {
   139	    fn from(disk: DiskBlock) -> Self {
   140	        match disk {
   141	            DiskBlock::Text { text } => ContentBlock::Text { text },
   142	            DiskBlock::Thinking {
   143	                thinking,
   144	                replay,
   145	                state,
   146	                signature: _,
   147	            } => match (replay, state) {
   148	                // A payload and the flag together make a replay block.
   149	                (true, Some(state)) => ContentBlock::ReasoningReplay {
   150	                    text: thinking,
   151	                    state: Some(state),
   152	                },
   153	                // `replay` with no payload has nothing to send, so it is history. rho says
   154	                // so once, because a provider that forgets its payload must not hide. See
   155	                // rule 11.
   156	                (true, None) => {
   157	                    tracing::warn!(
   158	                        "a session record claims a reasoning replay and carries no payload, \
   159	                         so it loads as history"
   160	                    );
   161	                    ContentBlock::ReasoningTrace { text: thinking }
   162	                }
   163	                // An old record, or a trace. Its signature is stale, so it is dropped.
   164	                (false, _) => ContentBlock::ReasoningTrace { text: thinking },
   165	            },
   166	            DiskBlock::ToolCall {
   167	                id,
   168	                name,
   169	                arguments,
   170	                state,
   171	            } => ContentBlock::ToolCall {
   172	                id,
   173	                name,
   174	                arguments,
   175	                state,
   176	            },
   177	            DiskBlock::ToolResult {
   178	                tool_call_id,
   179	                content,
   180	                is_error,
   181	            } => ContentBlock::ToolResult {
   182	                tool_call_id,
   183	                content,
   184	                is_error,
   185	            },
   186	            DiskBlock::Image { source } => ContentBlock::Image { source },
   187	        }
   188	    }
   189	}
   190	
   191	impl From<ContentBlock> for DiskBlock {
   192	    fn from(block: ContentBlock) -> Self {
   193	        match block {
   194	            ContentBlock::Text { text } => DiskBlock::Text { text },
   195	            ContentBlock::ReasoningTrace { text } => DiskBlock::Thinking {
   196	                thinking: text,
   197	                replay: false,
   198	                state: None,
   199	                signature: None,
   200	            },
   201	            ContentBlock::ReasoningReplay { text, state } => DiskBlock::Thinking {
   202	                thinking: text,
   203	                // A payload is what makes a record replayable, so the flag follows it.
   204	                replay: state.is_some(),
   205	                state,
   206	                signature: None,
   207	            },
   208	            ContentBlock::ToolCall {
   209	                id,
   210	                name,
   211	                arguments,
   212	                state,
   213	            } => DiskBlock::ToolCall {
   214	                id,
   215	                name,
   216	                arguments,
   217	                state,
   218	            },
   219	            ContentBlock::ToolResult {
   220	                tool_call_id,
   221	                content,
   222	                is_error,
   223	            } => DiskBlock::ToolResult {
   224	                tool_call_id,
   225	                content,
   226	                is_error,
   227	            },
   228	            ContentBlock::Image { source } => DiskBlock::Image { source },
   229	        }
   230	    }
   231	}
