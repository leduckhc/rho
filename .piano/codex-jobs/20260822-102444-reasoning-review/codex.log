    21	    #[default]
    22	    Summary,
    23	    /// Draw the summary row and the reasoning text, dimmed.
    24	    Full,
    25	    /// Draw the reasoning text while it streams, then collapse it to the summary row once
    26	    /// the model commits an answer or a tool call.
    27	    Live,
    28	}
