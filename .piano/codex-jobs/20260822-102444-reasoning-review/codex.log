   131	/// The `--sandbox` value. This mirrors `rho_core::SandboxMode` for clap, because
   132	/// `rho-core` carries no clap dependency. The default is `Off`, stated here.
   133	#[derive(Copy, Clone, Debug, PartialEq, Eq, ValueEnum)]
   134	pub enum SandboxArg {
   135	    /// No confinement. The default.
   136	    Off,
   137	    /// Writes limited to the session root and the scratch directory.
   138	    Confined,
   139	    /// `Confined`, plus no network.
   140	    Strict,
   141	}
   142	
   143	impl From<SandboxArg> for SandboxMode {
   144	    fn from(arg: SandboxArg) -> Self {
   145	        match arg {
   146	            SandboxArg::Off => SandboxMode::Off,
   147	            SandboxArg::Confined => SandboxMode::Confined,
   148	            SandboxArg::Strict => SandboxMode::Strict,
   149	        }
   150	    }
   151	}
