   145	/// Rule 11. A record that claims a replay and carries no payload loads as history, and
   146	/// rho says so, because a provider bug must not hide.
   147	#[test]
   148	fn a_replay_record_with_no_state_is_reported() {
   149	    let buffer = Arc::new(Mutex::new(Vec::<u8>::new()));
   150	    let subscriber = tracing_subscriber::fmt()
   151	        .with_writer(BufferWriter(Arc::clone(&buffer)))
   152	        .with_max_level(tracing::Level::TRACE)
   153	        .finish();
   154	    let block: ContentBlock = tracing::subscriber::with_default(subscriber, || {
   155	        serde_json::from_value(serde_json::json!({
   156	            "type": "thinking", "thinking": "x", "replay": true
   157	        }))
   158	        .expect("the record loads")
   159	    });
   160	    assert_eq!(
   161	        block,
   162	        ContentBlock::ReasoningTrace {
   163	            text: "x".to_string()
   164	        }
   165	    );
   166	    let logged = String::from_utf8(buffer.lock().unwrap().clone()).expect("valid utf8");
   167	    assert!(
   168	        logged.contains("no payload"),
   169	        "the load reports the claim it could not honour: {logged}"
   170	    );
   171	}
   172	
   173	/// A reasoning text is capped like any assistant text, so one turn cannot write a record
   174	/// that the reader then refuses.
   175	#[test]
   176	fn a_reasoning_text_over_the_string_cap_spills() {
   177	    let long = "y".repeat(rho_core::MAX_RECORD_BYTES);
   178	    let joined = recorded(ContentBlock::ReasoningTrace { text: long }).join("\n");
   179	    assert!(
   180	        joined.len() < rho_core::MAX_RECORD_BYTES * 2,
   181	        "the record is bounded"
   182	    );
   183	}
   184	
   185	/// Each `match block {` region of a source file, up to the arm that closes it.
   186	///
   187	/// Crude on purpose. It reads the text, because the alternative is a parser, and the guard
   188	/// only needs to see whether a wildcard sits beside the named arms.
   189	fn match_block_regions(source: &str) -> Vec<String> {
   190	    let mut regions = Vec::new();
   191	    for (start, _) in source.match_indices("match block {") {
   192	        let rest = &source[start..];
   193	        // The region ends at the first line that closes the match at its own indentation.
   194	        let end = rest
   195	            .find("\n        }")
   196	            .or_else(|| rest.find("\n    }"))
   197	            .unwrap_or(rest.len());
   198	        // Comments are dropped first. Every named arm here carries a comment that explains
   199	        // the drop, and one of them writes `_ => {}` to name what it avoids. The first
   200	        // version of this guard read that prose as code and failed the build for it.
   201	        let code: String = rest[..end]
   202	            .lines()
   203	            .filter(|line| !line.trim_start().starts_with("//"))
   204	            .collect::<Vec<_>>()
   205	            .join("\n");
   206	        regions.push(code);
   207	    }
   208	    regions
   209	}
   210	
   211	/// Every request builder names every content block. A stream parser may keep a wildcard,
   212	/// because a wire event set is open, but a request builder must not: that is how a reasoning
   213	/// block was dropped in silence, and how Azure kept dropping one for a whole sprint.
   214	#[test]
   215	fn every_request_builder_has_an_explicit_arm() {
   216	    for path in [
   217	        "../rho-provider-bedrock/src/lib.rs",
   218	        "../rho-provider-openrouter/src/lib.rs",
   219	        "../rho-provider-azure/src/lib.rs",
   220	    ] {
   221	        let source = std::fs::read_to_string(path).expect("the provider source reads");
   222	        let production = source
   223	            .split("#[cfg(test)]")
   224	            .next()
   225	            .expect("a source file has a first part");
   226	        for block in [
   227	            "ContentBlock::ReasoningTrace",
   228	            "ContentBlock::ReasoningReplay",
   229	            "ContentBlock::Image",
   230	        ] {
   231	            assert!(
   232	                production.contains(block),
   233	                "{path} must name {block} in an arm of its own"
   234	            );
   235	        }
   236	        // Naming the blocks is not enough. A wildcard beside them takes the traffic and
   237	        // the named arms become decoration. A deliberate break proved that: it added
   238	        // `_ => {}` and kept every name, and the first version of this guard passed. So
   239	        // the match over a content block is now read arm by arm.
   240	        for region in match_block_regions(production) {
   241	            assert!(
   242	                !region.contains("_ => {}") && !region.contains("_ => {"),
   243	                "{path} has a wildcard in a match over a content block:\n{region}"
   244	            );
   245	        }
   246	    }
   247	}
     1	# SPEC-reasoning-across-providers — one reasoning contract, and a table instead of branches
     2	
     3	Status: draft, for review before any implementation.
     4	Prior art: pi, jcode, and fx, all three read as source. See `docs/comparison.md`.
     5	
     6	Amended 20260821. The replay payload is now one opaque, owner-tagged provider state. See
     7	decision `D-reasoning-replay-is-opaque-provider-state`. Section 4 holds the change.
     8	
     9	## 0. The defects this fixes
    10	
    11	Each one is measured, and each has a named test in section 8.
    12	
    13	1. **rho shows `<thinking>` tags as the answer.** With Claude Haiku on Bedrock, rho never
    14	   asks for extended thinking, so the model writes `<thinking>...</thinking>` inside ordinary
    15	   text. rho draws that text as the answer, because to rho it is the answer.
    16	2. **rho reads one field name.** `rho-provider-openrouter` reads `delta.reasoning` only. A
    17	   model that uses `reasoning_content` or `reasoning_text` produces **no** reasoning in rho.
    18	   Measured against the same JSON: rho saw an empty string where pi saw the text.
    19	3. **rho drops a reasoning block when it builds a request.** The match arm is `_ => {}`. That
    20	   is silent, and `AGENTS.md` calls a silent drop a defect. It is harmless only while rho
    21	   never asks for thinking. It breaks a tool loop the moment rho does.
    22	4. **rho has no way to show the reasoning text.** The renderer holds
    23	   `Row::Thinking { text: _ }` and draws only `∴ thought for 2.4s`.
    24	
    25	## 1. The sides
    26	
    27	| Side | Owner | Must agree on |
    28	| --- | --- | --- |
    29	| The wire, read | each provider crate | which field names carry reasoning |
    30	| The wire, write | each provider crate | whether the endpoint wants it echoed back |
    31	| The data model | `rho-core` | the block kinds, and which one reaches a provider |
    32	| The persisted transcript | `rho-core` | what a session file holds, and what an old reader does |
    33	| The screen | `rho-tui` | how reasoning draws, and how the user turns it off |
    34	| The configuration | `rho-config`, `rho-cli` | the display mode, and the thinking budget |
    35	
    36	Contract kinds touched: the data model, the wire format, the persisted format, the
    37	configuration, and the behaviour rules.
    38	
    39	## 2. What pi does, what jcode does, and what fx does
    40	
    41	All three were read as source, not recalled.
    42	
    43	**pi** keeps one `thinking` block with a `thinkingSignature`, and decides at send time in
    44	`transform-messages.js`. Its rule is keyed on whether the same model answers:
    45	
    46	| Case | pi |
    47	| --- | --- |
    48	| redacted, same model | keep |
    49	| redacted, other model | drop, because it is opaque and would error |
    50	| has a signature, same model | keep, even when the text is empty |
    51	| empty text | drop |
    52	| other model | convert to plain text |
    53	
    54	pi reads three field names in order, `reasoning_content`, `reasoning`, then
    55	`reasoning_text`, and it takes **the first non-empty one**. Its comment names the reason:
    56	one host returns two fields with the same content, so a naive reader doubles the text.
    57	
    58	pi also inserts a synthetic tool result for an orphaned tool call, and its comment says this
    59	"preserves thinking signatures and satisfies API requirements".
    60	
    61	**jcode** splits the block in two, and this is the better idea:
    62	
    63	```rust
    64	ContentBlock::ReasoningTrace { text }                    // history only, never sent
    65	ContentBlock::AnthropicThinking { thinking, signature }  // replay, sent back
    66	ContentBlock::Reasoning { text }                         // replay, other providers
    67	```
    68	
    69	A trace is for a human. A replay block is for the provider. `push_reasoning_blocks` writes
    70	the trace only when the replay block did not already capture the same readable text, so the
    71	transcript never holds it twice.
    72	
    73	jcode also proves that replay is a **per-endpoint** property, and that guessing fails in
    74	both directions:
    75	
    76	| Endpoint | Rule | jcode issue |
    77	| --- | --- | --- |
    78	| Moonshot Kimi coding | **requires** `reasoning_content` on an assistant tool-call message | 322 |
    79	| DeepSeek, direct OpenAI-compatible | **requires** the stored `reasoning_content` replayed | 815 |
    80	| Mistral, strict OpenAI schema | **rejects** it with 422 `Extra inputs are not permitted` | 261 |
    81	
    82	And jcode records a third lesson, from three crashes: reasoning arrives as a byte stream, and
    83	slicing it at a non-character boundary panics and kills the process (issues 632, 633, 635).
    84	
    85	**fx** stores no reasoning at all. It asks the endpoint to return an encrypted payload with
    86	`include: ["reasoning.encrypted_content"]`, and it replays that payload from one opaque
    87	`provider_state_json` on the message. See `fx-src/src/gateway/openai_codex.zig:109` and
    88	`fx-src/src/core/shared/types.zig:909`.
    89	
    90	fx gives rho two things, one to copy and one to avoid:
    91	
    92	- **Copy the opaque payload.** A new host then needs no change to shared code. Section 4
    93	  takes it.
    94	- **Avoid the missing tag.** fx never records which provider wrote a payload, so a model or a
    95	  provider switch can send a foreign blob. rho tags the payload with its owner, and rule 8
    96	  drops a mismatch.
    97	
    98	fx also gates the ask on a model capability, and it fails closed when the catalogue does not
    99	list the effort. See `fx-src/src/core/config/model_capabilities.zig:95`. A project file in fx
   100	may not set the model or the effort, so a cloned repository cannot raise your spend.
   101	
   102	## 3. Where rho goes further
   103	
   104	Three additions. Each answers a defect that neither reference fixes.
   105	
   106	**One. The field names are data. The structure is not, and the spec says so.**
   107	
   108	An earlier draft of this section claimed that a table makes every new endpoint a row and
   109	never a branch. **A review proved that false, and the proof is Gemini.** Gemini does not put
   110	reasoning in a named field on a choice. It marks a part with `thought: true` inside
   111	`candidates[].content.parts`, and it carries `thoughtSignature` **per part**. No field name
   112	selects that, so extraction is structural and a row cannot express it.
   113	
   114	So the claim is narrowed to what is true:
   115	
   116	- **Reading is per-provider code.** A provider is its own crate in rho, and parsing its wire
   117	  format is that crate's job. That is the extension point: a new provider is a **new crate**
   118	  behind `trait Provider`, and no shared code changes. Gemini arrives that way.
   119	- **The table governs the OpenAI-compatible family only**, where the variation really is
   120	  field names. `rho-provider-openrouter` serves many hosts through one wire format, and
   121	  those hosts disagree only on the name. That is the case a table fits.
   122	- **The replay policy is data for every provider**, because the policy is a small closed set
   123	  and the failures are hard in both directions.
   124	
   125	```rust
   126	/// How one OpenAI-compatible endpoint names its reasoning, and what it wants echoed back.
   127	/// A new host in this family is a row. A provider with a different structure is a new crate.
   128	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
   129	pub struct ReasoningWire {
   130	    /// The delta field names to read, in order. The first non-empty one wins, because a
   131	    /// host that sends two fields with the same text would otherwise double it.
   132	    pub read_fields: &'static [&'static str],
   133	    /// What the endpoint needs echoed back on the next request.
   134	    pub replay: ReplayPolicy,
   135	    /// True when the endpoint rejects a reasoning field it did not send. Mistral answers
   136	    /// 422 `Extra inputs are not permitted`, so rho must send nothing.
   137	    pub rejects_unknown_fields: bool,
   138	    /// True when rho must ask for thinking before the model emits a structured block.
   139	    /// Without the ask, Claude writes `<thinking>` tags into ordinary text.
   140	    pub ask_to_enable: bool,
   141	}
   142	
   143	/// What an endpoint needs echoed back.
   144	///
   145	/// Named `ReplayPolicy`, and not `ReasoningReplay`, because `ContentBlock::ReasoningReplay` in
   146	/// section 4 already owns that name. One name per meaning.
   147	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
   148	pub enum ReplayPolicy {
   149	    /// Send nothing back. The trace stays in the transcript for the reader.
   150	    Never,
   151	    /// Send the payload back while the same owner answers. Anthropic requires its signature
   152	    /// inside a tool loop, and it rejects the turn without it.
   153	    SignedWhileSameModel,
   154	    /// Send the readable text back on an assistant tool-call message. The Kimi coding
   155	    /// endpoint rejects the message without it.
   156	    TextOnToolCall,
   157	    /// Send a signature back on the matching tool call, read from that call's
   158	    /// `ProviderState`. Gemini rejects the request with
   159	    /// `Function call is missing a thought_signature`, and jcode carries the same token.
   160	    SignatureOnToolCall,
   161	}
   162	```
   163	
   164	Every policy runs **after** the owner check of rule 8. A mismatched owner sends nothing,
   165	whatever the policy says. So a policy decides the shape of a replay, and the owner decides
   166	whether a replay may happen at all.
   167	
   168	**Two. rho reads `<thinking>` tags.** Neither pi nor jcode does. It is the defect the owner
   169	reported, so rho fixes it. The rule is narrow on purpose:
   170	
   171	- rho strips a tag pair only from the **start** of an assistant message, and only when the
   172	  opening tag is the first non-space text. A tag in the middle of an answer is prose about
   173	  tags, and rho must not eat it.
   174	- The accepted names are `<thinking>` and `<think>`.
   175	- Text inside becomes `ThinkingDelta`. Text after the closing tag becomes `TextDelta`.
   176	- An unclosed tag ends at the end of the message, because a truncated stream must not lose
   177	  the answer.
   178	- Stripping never changes what reaches the provider. It changes what rho draws.
   179	
   180	**Three. Nothing is dropped in silence.** Every content block has an explicit arm in every
   181	provider's request builder. A block that must not travel is dropped in a named arm with a
   182	comment, never by `_ => {}`.
   183	
   184	## 4. The data model
   185	
   186	```rust
   187	pub enum ContentBlock {
   188	    Text { text: String },
   189	    ToolCall {
   190	        id: String,
   191	        name: String,
   192	        arguments: serde_json::Value,
   193	        /// The replay payload some providers bind to this call. Gemini rejects a request
   194	        /// with `Function call is missing a thought_signature` when it is absent.
   195	        ///
   196	        /// This was `thought_signature: Option<String>`. A review killed that: the stream
   197	        /// event carried no such field, so Gemini would have had to edit shared code, and
   198	        /// a bare string had no owner, so it replayed after a model switch with nothing
   199	        /// checking it. One carrier, owner-tagged, on every replay path.
   200	        state: Option<ProviderState>,
   201	    },
   202	    ToolResult { tool_call_id: String, content: Vec<ContentBlock>, is_error: bool },
   203	
   204	    /// Readable reasoning, kept for the reader. **It never reaches a provider.**
   205	    ReasoningTrace { text: String },
   206	
   207	    /// Reasoning the provider needs echoed back.
   208	    ReasoningReplay {
   209	        /// The readable text. A cross-model turn falls back to this, as plain text.
   210	        text: String,
   211	        /// The opaque replay payload. `None` means there is nothing to replay.
   212	        state: Option<ProviderState>,
   213	    },
   214	}
   215	
   216	/// Which provider and which model produced a replay payload.
   217	#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
   218	pub struct ReasoningOwner {
   219	    /// The value of `Provider::id`, for example `bedrock`.
   220	    pub provider: String,
   221	    /// The model id of the request that produced the payload.
   222	    pub model: String,
   223	}
   224	
   225	/// One provider's own replay payload. Shared code never reads inside `value`.
   226	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
   227	pub struct ProviderState {
   228	    /// The pair that may read the value. See behaviour rule 8.
   229	    pub owner: ReasoningOwner,
   230	    /// The provider's private shape. It holds an Anthropic signature, an OpenAI reasoning
   231	    /// item, or whatever a later host needs.
   232	    pub value: serde_json::Value,
   233	}
   234	```
   235	
   236	The provider builds the whole `ProviderState`, because only the provider knows its own id and
   237	the model of the request. So the stream event carries it, and the typed signature goes:
   238	
   239	```rust
   240	pub enum StreamEvent {
   241	    // ... other variants unchanged ...
   242	    ThinkingEnd {
   243	        index: u32,
   244	        /// Replaces `signature: Option<String>`. A signature now travels inside `value`.
   245	        state: Option<ProviderState>,
   246	    },
   247	    ToolCallEnd {
   248	        index: u32,
   249	        arguments: serde_json::Value,
   250	        /// New. Without it a provider cannot bind a replay payload to its call, and the
   251	        /// extension point of section 7 is a promise rho cannot keep.
   252	        state: Option<ProviderState>,
   253	    },
   254	}
   255	```
   256	
   257	`Thinking { thinking, signature }` is replaced by these. The rename is the point: the old
   258	name never said which blocks travel, and that is why one was dropped in silence.
   259	
   260	### Why one opaque payload, and not a typed field per provider
   261	
   262	An earlier draft carried `signature: Option<String>` and nothing else. rho already **reads**
   263	an OpenAI-shaped reasoning item in `rho-provider-azure`, and that item is an id, a summary
   264	list, an encrypted blob, and a status. A single string cannot hold it. So rho could read a
   265	shape it could never send back.
   266	
   267	jcode answers this with a fourth typed variant. That puts every host's wire shape into shared
   268	code, and shared code then changes for each new host. fx answers it with one opaque value per
   269	message, and a new host costs nothing. rho takes fx's shape, and adds the tag fx lacks.
   270	
   271	**The signature is not a second carrier.** Two carriers for one job means two answers, and
   272	that is the family of defect that killed the `""` signature default. An Anthropic signature is
   273	now one key inside `value`, written and read by the crate that owns the wire.
   274	
   275	**A tool call keeps its typed `thought_signature`.** All three references carry that as a
   276	plain string, so the shape is settled and a name documents it better than a blob.
   277	
   278	**The honest cost.** The compiler no longer checks a payload. So rule 8 below is the whole
   279	guard, and it fails closed. A test for a mismatched owner is not optional.
   280	
   281	### What `value` may hold, and what bounds it
   282	
   283	A security review found the first draft of this part unsafe. Both bounds below come from it.
   284	
   285	**`value` holds opaque provider bytes only.** A signature, an encrypted blob, an item id, or a
   286	status. **No readable text.** The OpenAI item's `summary` is readable, so it goes in `text`,
   287	where the reader sees it and where the session cap already applies. This is what makes the
   288	redaction exemption of rule 9 safe: opaque bytes cannot be scanned for a secret, and they hold
   289	none that rho put there.
   290	
   291	**Both texts are capped like any assistant text.** `ReasoningTrace.text` and
   292	`ReasoningReplay.text` pass through `cap_block`, with the same spill as `ContentBlock::Text`.
   293	A `TextOnToolCall` endpoint then replays a capped text. That is the deliberate trade: a turn
   294	with reasoning past the cap is already pathological, and the other road writes a session file
   295	that cannot be read back.
   296	
   297	**A `value` is all or nothing.** Over `MAX_RECORD_BYTES` it is dropped whole, and rho reports
   298	it. A truncated opaque token is useless, and a truncated one that still looks valid is worse.
   299	
   300	**No wildcard may cover these blocks.** `redact_block` and `cap_block` in
   301	`rho-core/src/session/mod.rs` both end in `other => other.clone()` today, so a new variant
   302	joins them in silence. Each needs a named arm for both reasoning blocks.
   303	
   304	**The owner tag is accident protection, and not authentication.** It stops an honest mismatch
   305	after a model switch. It stops nothing in a session file that somebody crafted, because the
   306	tag sits beside the payload it describes. rho trusts a session file exactly as much as it
   307	trusts the rest of that file, and no more. The decision states this too, so nobody reads the
   308	tag as a signature.
   309	
   310	### The persisted format, in both directions
   311	
   312	A session file is a contract with every other version of rho, so both directions are stated.
   313	
   314	**A new rho reads an old file.** `"type": "thinking"` maps to `ReasoningTrace`. A signature
   315	from an older session is stale, and replaying it would fail, so it is not carried over.
   316	
   317	**An old rho reads a new file.** This was missing, and `AGENTS.md` step 3 requires it. An old
   318	rho uses a tagged enum with no `reasoning_trace` variant, so it **fails the whole load**. That
   319	is unacceptable, so both new variants share the old `"type": "thinking"` record:
   320	
   321	```json
   322	{"type": "thinking", "thinking": "...", "replay": true,
   323	 "state": {"owner": {"provider": "bedrock", "model": "anthropic.claude-haiku-4-5"},
   324	           "value": {"signature": "..."}}}
   325	```
   326	
   327	An old rho reads the text and ignores `replay` and `state`. A new rho reads `replay` to choose
   328	between `ReasoningTrace` and `ReasoningReplay`. A missing `replay` key reads as `false`, which
   329	is the safe direction: it never replays a stale payload.
   330	
   331	**`replay: true` with no `state` reads as a trace.** There is nothing to send, so the block
   332	becomes readable history. This is fail-closed, and it also covers a file written by a rho that
   333	crashed between the two keys.
   334	
   335	**A `state` value is stored verbatim.** A redacted payload cannot replay, so nothing rewrites
   336	it on the way to the file. Rule 9 states the matching log rule.
   337	
   338	**An old `signature` key is read and dropped.** A file from before this change maps to
   339	`ReasoningTrace`, and a stale signature never replays.
   340	
   341	**An imported pi session holds traces only.** `rho-session-import-pi` cannot know which
   342	`Provider::id` and model wrote pi's `thinkingSignature`, so it can build no honest owner. It
   343	writes `ReasoningTrace`, and an imported signature never replays. A review found this, and the
   344	alternative was a guessed owner, which rule 8 exists to refuse.
   345	
   346	### How one tag carries two variants
   347	
   348	The first draft of this section was **wrong**, and a compile proved it. Two enum variants
   349	cannot share one serde tag. Both `#[serde(rename = "thinking")]` variants compile, and the
   350	reader then returns the **first** one every time. A replay block came back as a trace, and
   351	nothing said so. That is a silent drop, which `AGENTS.md` names as a defect. See decision
   352	`D-two-variants-cannot-share-a-serde-tag`.
   353	
   354	So the file shape is its own type, and the conversion happens at the boundary:
   355	
   356	```rust
   357	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
   358	#[serde(from = "DiskBlock", into = "DiskBlock")]
   359	pub enum ContentBlock { /* the variants of section 4 */ }
   360	
   361	/// The on-disk shape. One `thinking` record carries both reasoning variants.
   362	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
   363	#[serde(tag = "type", rename_all = "snake_case")]
   364	enum DiskBlock {
   365	    Thinking {
   366	        thinking: String,
   367	        #[serde(default)]
   368	        replay: bool,
   369	        #[serde(default, skip_serializing_if = "Option::is_none")]
   370	        state: Option<ProviderState>,
   371	        /// Read from an old file, and never written.
   372	        #[serde(default, skip_serializing_if = "Option::is_none")]
   373	        signature: Option<String>,
   374	    },
   375	    // ... one variant per block of section 4 ...
   376	}
   377	```
   378	
   379	The conversion holds the rules: `replay: true` with a state gives `ReasoningReplay`, and every
   380	other case gives `ReasoningTrace`. This shape was transcribed to a scratch crate outside the
   381	repository, and its four round-trip tests pass. See `docs/verification/` once the code lands.
   382	
   383	**A truncated line.** A session log is append-only and line-delimited. A reader drops a final
   384	line that does not parse, and it says so once. A half-written reasoning block must never stop
   385	a session from loading.
   386	
   387	## 5. The display
   388	
   389	```rust
   390	/// How rho draws reasoning.
   391	#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
   392	pub enum ReasoningDisplay {
   393	    /// Draw nothing. No text, and no summary row.
   394	    Off,
   395	    /// Draw a one-row summary only, for example `∴ thought for 2.4s`.
   396	    #[default]
   397	    Summary,
   398	    /// Draw the reasoning text, dimmed, and keep it in the transcript.
   399	    Full,
   400	    /// Draw the reasoning text while it streams, then collapse it to the summary row.
   401	    Live,
   402	}
   403	```
   404	
   405	**A correction to an earlier draft.** It called these "jcode's three modes, and its default".
   406	That was wrong twice. jcode has `Off`, `Full`, and `Current`, and it defaults to `Off`. The
   407	earlier draft dropped `Off` entirely, which removed the only way to hide reasoning, and a
   408	review named that a capability regression. `Off` is back.
   409	
   410	rho keeps four modes and defaults to `Summary`. That is a deliberate difference from jcode: a
   411	turn that thought for nine seconds and says so is honest, while a turn that hides the nine
   412	seconds looks stalled.
   413	
   414	The reasoning text draws in `Role::Muted`, never in `Role::Text`. Dim is the whole point: it
   415	is the model's private work, and it must never read as the answer.
   416	
   417	**The text is always stored, in every mode.** A user who switches to `Full` in the middle of a
   418	session must not find the earlier reasoning empty. The cost is bounded, because the transcript
   419	is already held in memory and reasoning is a fraction of it. `Off` changes what draws, and
   420	never what is kept.
   421	
   422	**When `Live` collapses.** "The model commits an answer" is not an event, so the earlier
   423	wording was untestable. The rule is now stated against real events: `Live` collapses on the
   424	first `TextDelta` that follows the reasoning block, or on a `ToolCallStart`, whichever comes
   425	first. Both are observable, so a test can assert the exact frame.
   426	
   427	Config key `tui-reasoning`, values `off`, `summary`, `full`, `live`. CLI `--reasoning <mode>`.
   428	An unknown value is an error at every source, and rho draws nothing. See decision
   429	D-a-bad-reasoning-mode-is-refused.
   430	
   431	## 6. The behaviour rules
   432	
   433	1. Read the delta fields in order, and take the first non-empty one.
   434	2. An empty delta adds nothing and starts no block.
   435	3. Slice a reasoning delta only on a character boundary. jcode crashed three times here.
   436	4. Never send a `ReasoningTrace`. Send a `ReasoningReplay` only when `ReasoningWire` says so.
   437	5. An orphaned tool call gets a synthetic error result, so the signature chain stays whole.
   438	6. A redacted block replays only while the same model answers, and it is dropped otherwise.
   439	7. Strip a leading `<thinking>` or `<think>` pair, and only a leading one. The rules below
   440	   say how, because the stream is incremental and a message-global rule cannot be applied one
   441	   delta at a time.
   442	8. A provider replays a `state` only when `owner.provider` equals its own `Provider::id`, and
   443	   `owner.model` equals the model of the request. A mismatch drops the state in a named arm,
   444	   and the request carries no reasoning payload. The drop is never silent, and never partial.
   445	9. A `state` value never reaches a log, at any level, including `trace`. It is written to the
   446	   session file verbatim, because a rewritten payload cannot replay.
   447	10. A `value` over `MAX_RECORD_BYTES` is dropped whole, and rho reports it. A reasoning text
   448	    over the string cap spills, exactly as an assistant text does.
   449	11. rho reports a `replay: true` record that carries no `state`. It reads as a trace, and the
   450	    report says so once, so a provider bug does not hide.
   451	12. A request builder has a named arm for every content block. A stream parser may keep a
   452	    wildcard, because a wire event set is open and a provider adds events without rho.
   453	    `rho-provider-azure/src/lib.rs:600` is a request builder, so its `_ => {}` goes.
   454	
   455	### The tag rule, stated for a stream
   456	
   457	A review found that rule 7 could not be implemented as first written. The pipeline emits a
   458	delta at a time, so "the first non-space text" is unknown until enough text has arrived.
   459	
   460	- rho holds a **lead buffer** until it can decide. The buffer is at most the length of the
   461	  longest accepted opening tag, so an opening tag split across three deltas still matches.
   462	- Nothing is emitted from the buffer until the decision is made. So a caller never sees text
   463	  that rho later reclassifies.
   464	- The tag name matches **without case**, so `<Thinking>` is a tag.
   465	- `<thinking/>` is a self-closing tag. It opens and closes an empty reasoning block, and it
   466	  never opens a region.
   467	- Once the first non-space text is known not to be a tag, the buffer flushes as text and rho
   468	  stops looking for the rest of the message. A tag in the middle stays text.
   469	- **An unclosed tag stops at the first `ToolCallStart`.** Otherwise a missing closing tag
   470	  would swallow the whole answer as reasoning. At the end of a message an unclosed tag also
   471	  stops, and the text is kept.
   472	- **The case rho cannot separate.** A user may ask the model to print a literal `<thinking>`
   473	  tag, and the answer then legitimately begins with one. rho cannot tell that from real
   474	  reasoning, because the bytes are identical. rho chooses the safer failure: when the model
   475	  emitted a structured reasoning block in the same turn, rho does **not** strip a tag from the
   476	  text, because the reasoning already arrived by the proper path. Tag stripping applies only
   477	  to a turn with no structured reasoning at all.
   478	
   479	## 7. Out of scope
   480	
   481	- **Choosing the budget numbers by measurement.** Section 9 states a ladder, and it is a
   482	  starting point, not a measured optimum. A measurement gets its own bench and its own spec.
   483	- **A reasoning search.** The transcript holds the trace, and the terminal searches it.
   484	- **Google and Mistral provider crates.** rho has none yet. Mistral joins the
   485	  OpenAI-compatible table as a row. **Google does not**, and section 3 says why: its reasoning
   486	  is structural, so it arrives as a new crate behind `trait Provider`. The `SignatureOnToolCall`
   487	  replay policy, the `ProviderState` on a `ToolCall`, and the `state` field on `ToolCallEnd`
   488	  exist now, so that crate needs no change to shared code when it lands.
   489	- **Token accounting for reasoning.** Anthropic reports it in
   490	  `output_tokens_details.thinking_tokens`, and the footer work is separate.
   491	
   492	## 8. Test cases
   493	
   494	### Reading the wire
   495	
   496	- `the_first_non_empty_reasoning_field_wins` — a delta with `reasoning_content` and
   497	  `reasoning` holding the same text yields the text **once**.
   498	- `reasoning_content_is_read` — the field pi added for llama.cpp produces a delta. rho reads
   499	  nothing here today.
   500	- `reasoning_text_is_read` — the third name produces a delta.
   501	- `an_empty_reasoning_delta_starts_no_block` — no `ThinkingStart` for an empty string.
   502	- `a_reasoning_delta_splits_on_a_character_boundary` — a multi-byte character split across
   503	  two deltas does not panic and does not corrupt.
   504	
   505	### The tags
   506	
   507	- `a_leading_thinking_tag_becomes_reasoning` — `<thinking>a</thinking>b` yields reasoning
   508	  `a` and text `b`.
   509	- `a_leading_think_tag_becomes_reasoning` — the short name works too.
   510	- `a_tag_in_the_middle_stays_text` — `here is a <thinking> tag` stays text in full. This is
   511	  the rule that stops rho eating an answer about tags.
   512	- `an_unclosed_tag_ends_at_the_message_end` — a truncated stream keeps its text.
   513	- `a_stripped_tag_does_not_change_the_request` — what reaches the provider is unchanged.
   514	
   515	### The replay
   516	
   517	- `a_trace_never_reaches_a_provider` — every provider's request builder omits
   518	  `ReasoningTrace`.
   519	- `a_state_replays_for_the_same_owner` — Anthropic gets its signature back, inside `value`.
   520	- `a_state_is_dropped_for_another_model` — a model change drops the payload, by rule 8.
