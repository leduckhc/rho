     1	//! The normalised streaming event.
     2	//!
     3	//! Every provider emits this one event type. Every frontend consumes it. The
     4	//! provider maps its own wire format onto these variants.
     5	
     6	use crate::{Role, Usage};
     7	use serde::{Deserialize, Serialize};
     8	
     9	use crate::StopReason;
    10	
    11	/// A normalised streaming event, provider-agnostic.
    12	///
    13	/// `index` groups events for one content block within the current message.
    14	/// A provider emits a `*Start`, then zero or more `*Delta`, then a `*End` for
    15	/// each block, in `index` order.
    16	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
    17	#[serde(tag = "kind", rename_all = "snake_case")]
    18	pub enum StreamEvent {
    19	    /// The assistant message begins.
    20	    MessageStart {
    21	        role: Role,
    22	    },
    23	    TextStart {
    24	        index: u32,
    25	    },
    26	    TextDelta {
    27	        index: u32,
    28	        delta: String,
    29	    },
    30	    TextEnd {
    31	        index: u32,
    32	    },
    33	    ThinkingStart {
    34	        index: u32,
    35	    },
    36	    ThinkingDelta {
    37	        index: u32,
    38	        delta: String,
    39	    },
    40	    ThinkingEnd {
    41	        index: u32,
    42	        /// The provider's opaque replay payload, or `None` when it sent none. It replaces
    43	        /// `signature: Option<String>`: a signature now travels inside the payload, so one
    44	        /// carrier covers every provider. See `SPEC-reasoning-across-providers` section 4.
    45	        state: Option<crate::ProviderState>,
    46	    },
    47	    /// A tool call begins. The name is known at the start.
    48	    ToolCallStart {
    49	        index: u32,
    50	        id: String,
    51	        name: String,
    52	    },
    53	    /// A raw JSON fragment of the tool-call arguments.
    54	    ToolCallDelta {
    55	        index: u32,
    56	        delta: String,
    57	    },
    58	    /// The tool call is complete. `arguments` is the parsed JSON object.
    59	    ToolCallEnd {
    60	        index: u32,
    61	        arguments: serde_json::Value,
    62	        /// The replay payload a provider binds to this call, such as Gemini's thought
    63	        /// signature. Without this field a provider could not carry one, and the extension
    64	        /// point of the spec would be a promise rho cannot keep.
    65	        state: Option<crate::ProviderState>,
    66	    },
    67	    /// Cumulative token usage, reported one or more times.
    68	    Usage(Usage),
    69	    /// The turn is done. This is the last event of a successful turn.
    70	    Done {
    71	        stop_reason: StopReason,
    72	    },
    73	}
   760	    text: Option<String>,
   761	    thinking: Option<String>,
   762	    tool_call: Option<(String, String)>,
   763	}
   764	
   765	impl AssistantBuilder {
   766	    /// Fold one stream event into the message under construction.
   767	    fn observe(&mut self, event: &StreamEvent) {
   768	        match event {
   769	            StreamEvent::TextStart { .. } => self.text = Some(String::new()),
   770	            StreamEvent::TextDelta { delta, .. } => {
   771	                if let Some(text) = self.text.as_mut() {
   772	                    text.push_str(delta);
   773	                }
   774	            }
   775	            StreamEvent::TextEnd { .. } => {
   776	                if let Some(text) = self.text.take() {
   777	                    self.content.push(ContentBlock::Text { text });
   778	                }
   779	            }
   780	            StreamEvent::ThinkingStart { .. } => self.thinking = Some(String::new()),
   781	            StreamEvent::ThinkingDelta { delta, .. } => {
   782	                if let Some(thinking) = self.thinking.as_mut() {
   783	                    thinking.push_str(delta);
   784	                }
   785	            }
   786	            // A payload makes the block replayable. Without one it is history for the
   787	            // reader, and the type stops it reaching a provider at all.
   788	            StreamEvent::ThinkingEnd { state, .. } => {
