     1	//! The `rho` command line interface.
     2	//!
     3	//! Three entry points must work: `rho --help`, `rho run <prompt>` for a headless
     4	//! answer on stdout, and `rho` for the interactive TUI. This module parses the
     5	//! arguments, builds a `SessionConfig` explicitly, and runs the chosen mode.
     6	//!
     7	//! The session config is stated out loud here. Decision D-no-four-argument-session-new deleted a
     8	//! convenience constructor because it hid a fake model id, an accidental session
     9	//! root, and a policy that approved every tool call. So this module names the
    10	//! model, the session root, and the approval policy in the calling code.
    11	
    12	use std::io::Write;
    13	use std::path::PathBuf;
    14	use std::sync::Arc;
    15	
    16	use clap::ValueEnum;
    17	use clap::{Parser, Subcommand};
    18	use futures::StreamExt;
    19	use rho_core::{
    20	    AgentEvent, AllowAllPolicy, ApprovalPolicy, CancelToken, ContentBlock, Context, ReadOnlyPolicy,
    21	    SandboxMode, Session, SessionConfig, StreamEvent,
    22	};
    23	
    24	use crate::extensions;
    25	use crate::provider::{self, MODEL_ENV};
    26	use crate::subagents;
