    97	/// Rule 10. A payload over the record cap is dropped whole, and the drop is reported.
    98	#[test]
    99	fn a_value_over_the_record_cap_is_dropped_and_reported() {
   100	    let buffer = Arc::new(Mutex::new(Vec::<u8>::new()));
   101	    let subscriber = tracing_subscriber::fmt()
   102	        .with_writer(BufferWriter(Arc::clone(&buffer)))
   103	        .with_max_level(tracing::Level::TRACE)
   104	        .finish();
   105	    let joined = tracing::subscriber::with_default(subscriber, || {
   106	        let huge = "x".repeat(rho_core::MAX_RECORD_BYTES + 1);
   107	        let block = ContentBlock::ReasoningReplay {
   108	            text: "a plan".to_string(),
   109	            state: Some(state(serde_json::json!({ "signature": huge }))),
   110	        };
   111	        recorded(block).join("\n")
   112	    });
   113	    assert!(
   114	        !joined.contains(&"x".repeat(1000)),
   115	        "the oversize payload is not written"
   116	    );
   117	    assert!(
   118	        joined.contains("a plan"),
   119	        "the readable text survives the drop"
   120	    );
   121	    let logged = String::from_utf8(buffer.lock().unwrap().clone()).expect("valid utf8");
   122	    // The report names the size and the provider, and never the value.
   123	    assert!(
   124	        logged.contains("exceeded the record cap") && logged.contains("bedrock"),
   125	        "the drop is reported: {logged}"
   126	    );
   127	    assert!(
   128	        !logged.contains(&"x".repeat(1000)),
   129	        "the report never carries the payload"
   130	    );
   131	}
