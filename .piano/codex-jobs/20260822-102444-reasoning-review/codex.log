   108	/// Configuration for one agent run.
   109	#[derive(Clone, Copy, Debug)]
   110	pub struct AgentConfig {
   111	    /// The per-run turn cap. The loop stops with `MaxTurnRequests` at the cap.
   112	    pub max_turns: u32,
   113	}
   114	
   115	impl Default for AgentConfig {
   116	    fn default() -> Self {
   117	        Self { max_turns: 32 }
   118	    }
   119	}
   120	
   121	/// The event stream of one agent run.
   122	///
   123	/// Drop this value to cancel the run. `Drop` aborts the driver task, which drops
   124	/// the provider stream and any running tool future. No task leaks.
   125	pub struct AgentEvents {
   126	    rx: tokio::sync::mpsc::Receiver<Result<AgentEvent, Error>>,
   127	    handle: tokio::task::JoinHandle<()>,
   128	}
   129	
   130	impl Stream for AgentEvents {
   131	    type Item = Result<AgentEvent, Error>;
   132	    fn poll_next(mut self: Pin<&mut Self>, cx: &mut TaskContext<'_>) -> Poll<Option<Self::Item>> {
   133	        self.rx.poll_recv(cx)
   134	    }
   135	}
   136	
   137	impl Drop for AgentEvents {
   138	    fn drop(&mut self) {
   139	        self.handle.abort();
   140	    }
   141	}
