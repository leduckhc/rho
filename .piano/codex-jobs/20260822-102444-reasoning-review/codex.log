   541	/// Map one normalised message to **one or more** Responses input items.
   542	///
   543	/// One message can produce several items, so this returns a list. An assistant turn
   544	/// with text and two tool calls becomes three items.
   545	///
   546	/// A live run against Azure forced this shape. The Responses API answered 400 with
   547	/// `Invalid value: 'tool'. Supported values are: 'assistant', 'system', 'developer',
   548	/// and 'user'.` Responses has no tool role. It mixes messages and typed items in one
   549	/// `input` array:
   550	///
   551	/// - a message is `{"role": ..., "content": ...}`;
   552	/// - a tool call is `{"type": "function_call", "call_id": ..., "name": ..., "arguments": "<json string>"}`;
   553	/// - a tool result is `{"type": "function_call_output", "call_id": ..., "output": ...}`.
   554	///
   555	/// Two rules are easy to miss, and both cost a 400.
   556	///
   557	/// First, `arguments` is a JSON **string**, not an object.
   558	///
   559	/// Second, a `function_call` item must appear before its own `function_call_output`,
   560	/// and the `call_id` values must match. The provider used to drop assistant tool
   561	/// calls entirely, so an output referenced a call the service had never seen.
   562	fn message_to_items(message: &Message) -> Vec<Value> {
   563	    let mut items = Vec::new();
   564	    let mut text = String::new();
   565	
   566	    for block in &message.content {
   567	        match block {
   568	            ContentBlock::Text { text: piece } => text.push_str(piece),
   569	            ContentBlock::ToolCall {
   570	                id,
   571	                name,
   572	                arguments,
   573	                // No replay payload travels on this wire yet. Gemini binds one to a call.
   574	                state: _,
   575	            } => {
   576	                // Flush any prose that came before the call, so order survives.
   577	                if !text.is_empty() {
   578	                    items.push(json!({ "role": role_name(message.role), "content": text }));
   579	                    text = String::new();
   580	                }
   581	                items.push(json!({
   582	                    "type": "function_call",
   583	                    "call_id": id,
   584	                    "name": name,
   585	                    "arguments": arguments.to_string(),
   586	                }));
   587	            }
   588	            ContentBlock::ToolResult {
   589	                tool_call_id,
   590	                content,
   591	                ..
   592	            } => {
   593	                let mut output = String::new();
   594	                for inner in content {
   595	                    if let ContentBlock::Text { text: piece } = inner {
   596	                        output.push_str(piece);
   597	                    }
   598	                }
   599	                items.push(json!({
   600	                    "type": "function_call_output",
   601	                    "call_id": tool_call_id,
   602	                    "output": output,
   603	                }));
   604	            }
   605	            // A trace is for the reader, so it never travels.
   606	            ContentBlock::ReasoningTrace { .. } => {}
   607	            // Azure returns a reasoning summary and no replay token on this path, so rho
   608	            // stores no payload and has nothing to send back. The named arm replaces a
   609	            // `_ => {}` that a review found: a wildcard in a request builder hides the next
   610	            // block kind, and that is how a reasoning block was dropped in silence before.
   611	            ContentBlock::ReasoningReplay { .. } => {}
   612	            // Image input in a request is out of scope for sprint 1.
   613	            ContentBlock::Image { .. } => {}
   614	        }
   615	    }
   616	
   617	    // Emit trailing prose. Skip an empty message, because an empty content string
   618	    // adds nothing and some models reject it.
   619	    if !text.is_empty() {
   620	        items.push(json!({ "role": role_name(message.role), "content": text }));
   621	    }
   622	    items
   623	}
   624	
   625	/// The Responses role name for a normalised role.
   626	///
   627	/// `Role::Tool` never reaches this function through a normal path, because a tool
   628	/// result becomes a `function_call_output` item. It maps to `user` as a safe
   629	/// fallback, since Responses would reject `tool`.
   630	fn role_name(role: Role) -> &'static str {
   631	    match role {
   632	        Role::User | Role::Tool => "user",
   633	        Role::Assistant => "assistant",
   634	    }
   635	}
   500	            events.push(StreamEvent::ToolCallStart { index, id, name });
   501	        }
   502	        if let Some(function) = &fragment.function
   503	            && let Some(arguments) = &function.arguments
   504	            && !arguments.is_empty()
   505	        {
   506	            accum.buffer.push_str(arguments);
   507	            events.push(StreamEvent::ToolCallDelta {
   508	                index,
   509	                delta: arguments.clone(),
   510	            });
   511	        }
   512	    }
   513	
   514	    /// Close the open blocks at the end of the turn. Return a decode error when a
   515	    /// tool-call buffer does not parse.
   516	    fn close_blocks(&mut self, events: &mut Vec<StreamEvent>) -> Option<ProviderError> {
   517	        if self.text_open {
   518	            events.push(StreamEvent::TextEnd {
   519	                index: Self::TEXT_INDEX,
   520	            });
   521	            self.text_open = false;
   522	        }
   523	        if self.thinking_open {
   524	            events.push(StreamEvent::ThinkingEnd {
   525	                index: Self::TEXT_INDEX,
   526	                // This wire carries no replay token, so the reducer keeps a trace.
   527	                state: None,
   528	            });
   529	            self.thinking_open = false;
   530	        }
   531	        let tool_calls = std::mem::take(&mut self.tool_calls);
   532	        for (index, accum) in tool_calls {
   533	            let arguments = if accum.buffer.trim().is_empty() {
   534	                Value::Object(serde_json::Map::new())
   535	            } else {
   536	                match serde_json::from_str(&accum.buffer) {
   537	                    Ok(value) => value,
   538	                    Err(error) => {
   539	                        return Some(ProviderError::Decode(format!(
   540	                            "the tool-call arguments did not parse as JSON: {error}"
   541	                        )));
   542	                    }
   543	                }
   544	            };
   545	            events.push(StreamEvent::ToolCallEnd {
   546	                index,
   547	                arguments,
   548	                state: None,
   549	            });
   550	        }
   551	        None
   552	    }
   553	}
   554	
   555	/// Map an OpenRouter finish reason to a normalised stop reason.
   556	fn finish_reason_to_stop(reason: &str) -> StopReason {
   557	    match reason {
   558	        "stop" => StopReason::EndTurn,
   559	        "length" => StopReason::MaxTokens,
   560	        "tool_calls" => StopReason::ToolUse,
   561	        "content_filter" => StopReason::ContentFiltered,
   562	        _ => StopReason::EndTurn,
   563	    }
   564	}
   565	
   566	// --- The request body. ---------------------------------------------------
   567	
   568	/// Build the chat-completions request body. See `SPEC-provider-interface` section 4.
   569	pub fn build_request_body(request: &CompletionRequest) -> Value {
   570	    let mut messages = Vec::new();
   571	    if let Some(system) = &request.system {
   572	        messages.push(json!({ "role": "system", "content": system }));
   573	    }
   574	    for message in &request.messages {
   575	        messages.push(message_to_json(message));
   576	    }
   577	
   578	    let mut body = json!({
   579	        "model": request.model,
   580	        "messages": messages,
   581	        "stream": true,
   582	        // Ask for the accounting, or none arrives.
   583	        //
   584	        // OpenRouter omits `usage` from a streamed response unless the request opts in.
   585	        // So rho parsed the cache and cost fields correctly and never received them. A
   586	        // live run of fifty sessions reported zero tokens and no cost, which is what
   587	        // exposed it. This is the same shape as the timeout guidance that never fired:
   588	        // the code was right and unreachable. See decision D-measured-cost-and-cache.
   589	        "usage": { "include": true },
   590	    });
   591	    let map = body.as_object_mut().expect("the body is an object");
   592	    if !request.tools.is_empty() {
   593	        let tools: Vec<Value> = request
   594	            .tools
   595	            .iter()
   596	            .map(|tool| {
   597	                json!({
   598	                    "type": "function",
   599	                    "function": {
   600	                        "name": tool.name,
   601	                        "description": tool.description,
   602	                        "parameters": tool.input_schema,
   603	                    }
   604	                })
   605	            })
   606	            .collect();
   607	        map.insert("tools".to_string(), Value::Array(tools));
   608	    }
   609	    if let Some(max_tokens) = request.max_tokens {
   610	        map.insert("max_tokens".to_string(), json!(max_tokens));
   611	    }
   612	    if let Some(temperature) = request.temperature {
   613	        map.insert("temperature".to_string(), json!(temperature));
   614	    }
   615	    body
   616	}
   617	
   618	/// Map one normalised message to the OpenAI chat message shape.
   619	fn message_to_json(message: &Message) -> Value {
   620	    let role = match message.role {
   621	        Role::User => "user",
   622	        Role::Assistant => "assistant",
   623	        Role::Tool => "tool",
   624	    };
   625	    let mut text = String::new();
   626	    let mut tool_calls = Vec::new();
   627	    let mut tool_call_id: Option<String> = None;
   628	    for block in &message.content {
   629	        match block {
   630	            ContentBlock::Text { text: piece } => text.push_str(piece),
   631	            ContentBlock::ToolCall {
   632	                id,
   633	                name,
   634	                arguments,
   635	                // No replay payload travels on this wire yet. Gemini binds one to a call.
   636	                state: _,
   637	            } => {
   638	                tool_calls.push(json!({
   639	                    "id": id,
   640	                    "type": "function",
   641	                    "function": {
   642	                        "name": name,
   643	                        "arguments": arguments.to_string(),
   644	                    }
   645	                }));
   646	            }
   647	            ContentBlock::ToolResult {
   648	                tool_call_id: id,
   649	                content,
   650	                ..
   250	    // never stops the session, so this call cannot fail.
   251	    //
   252	    // The skill list, the discovery switch, and the MCP path all come from the merge, so a
   253	    // config file reaches them. `--trust-project` stays a flag, because it is the trust
   254	    // decision itself and a file cannot grant itself trust.
   255	    let extensions = extensions::load(
   256	        &config.session_root,
   257	        cli.trust_project,
   258	        &loaded.skill_paths,
   259	        loaded.discover_skills,
   260	        loaded.mcp_config.as_deref(),
   261	    )
   262	    .await;
   263	
   264	    let mut registry =
   265	        rho_tools::builtin_registry_with_tasks_and_sandbox(Arc::clone(&tasks), config.sandbox);
   266	    for tool in &extensions.mcp_tools {
   267	        registry.register(Arc::clone(tool));
   268	    }
   269	    let hooks = Arc::new(rho_core::HookChain::default());
   270	
   271	    // Subagents. The parent's tool set is captured **before** `spawn_agent` joins it, so a
   272	    // child can never receive `spawn_agent` through the intersection. Depth is enforced too,
   273	    // and this makes the common case structural rather than a check.
   274	    let parent_tools: Vec<Arc<dyn rho_core::Tool>> =
   275	        rho_tools::builtin_tools_with_tasks_and_sandbox(Arc::clone(&tasks), config.sandbox)
   276	            .into_iter()
   277	            .chain(extensions.mcp_tools.iter().map(Arc::clone))
   278	            .collect();
   279	    let (spawn_tool, subagents) = subagents::load(subagents::LoadRequest {
   280	        session_root: config.session_root.clone(),
   281	        trust_project: cli.trust_project,
   282	        discover: loaded.discover_skills,
   283	        parent_config: config.clone(),
   284	        provider: Arc::clone(&provider),
   285	        hooks: Arc::clone(&hooks),
   286	        parent_tools,
   287	        limits: rho_core::SubagentLimits::default(),
   288	    })
   289	    .await;
   290	    if let Some(tool) = spawn_tool {
   291	        registry.register(tool);
   292	    }
   293	    let tools = Arc::new(registry);
   294	
   295	    // The skills block joins the stable prefix, never the dynamic part. The skill set
   296	    // is fixed for a session, so the prefix stays byte-identical and the provider
   297	    // prompt cache survives. See SPEC-core-runtime section 1 and SPEC-skills section 6.
   298	    let mut prompt = system_prompt();
   299	    if !extensions.skills_prompt.is_empty() {
   300	        prompt.push_str("\n\n");
   301	        prompt.push_str(&extensions.skills_prompt);
   302	    }
   303	
   304	    let context = Context::new(Some(prompt), tools.specs());
   305	    Ok((
   306	        Session::with_config(config, provider, tools, hooks, context),
   307	        tasks,
   308	        SessionExtras {
   309	            notices: extensions
   310	                .notices
   311	                .into_iter()
   312	                .chain(subagents.notices)
   313	                .collect(),
   314	            agents: subagents.registry,
   315	            agent_definitions: subagents.loaded,
   316	            mcp_pool: extensions.mcp_pool,
   317	        },
   318	    ))
   319	}
   320	
   321	/// What a caller must hold, and what it should show the user.
   322	struct SessionExtras {
   323	    /// Lines to print once, before the session starts.
   324	    notices: Vec<String>,
   325	    /// The subagent registry. Holding it keeps the process-wide live cap in force for as
   326	    /// long as the session, and the spawn tree shares this handle.
   327	    #[allow(dead_code)]
   328	    agents: rho_core::AgentRegistry,
   329	    /// How many agent definitions loaded. Zero means `spawn_agent` is not registered, so a
   330	    /// status line can say why the tool is absent.
   331	    #[allow(dead_code)]
   332	    agent_definitions: usize,
   333	    /// The MCP pool. Holding it keeps the servers alive for the session.
   334	    #[allow(dead_code)]
   335	    mcp_pool: Option<std::sync::Arc<rho_mcp::McpPool>>,
   336	}
   337	
   338	/// The short system prompt. A short prompt keeps the prefix small. See F-short-system-prompt.
   339	fn system_prompt() -> String {
   340	    // The prompt stays short on purpose. See F-short-system-prompt. It says only what the model cannot
   341	    // work out from the tool schemas, and background behaviour is exactly that: the
   342	    // model needs to know that a long command returns a task id, and that it should
   343	    // wait on an event rather than sleep.
   344	    "You are rho, a coding agent. You use the tools to read and change files. \
   345	     You keep answers short.\n\
   346	     A long command runs in the background and returns a task id at once. \
   347	     Use the task tool with the wait action to be woken when it finishes or \
   348	     reports progress. Never sleep and poll."
   349	        .to_string()
   350	}
