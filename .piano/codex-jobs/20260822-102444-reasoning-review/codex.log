   172	
   173	/// A reasoning text is capped like any assistant text, so one turn cannot write a record
   174	/// that the reader then refuses.
   175	#[test]
   176	fn a_reasoning_text_over_the_string_cap_spills() {
   177	    let long = "y".repeat(rho_core::MAX_RECORD_BYTES);
   178	    let joined = recorded(ContentBlock::ReasoningTrace { text: long }).join("\n");
   179	    assert!(
   180	        joined.len() < rho_core::MAX_RECORD_BYTES * 2,
   181	        "the record is bounded"
   182	    );
   183	}
   184	
   185	/// Each `match block {` region of a source file, up to the arm that closes it.
   186	///
   187	/// Crude on purpose. It reads the text, because the alternative is a parser, and the guard
   188	/// only needs to see whether a wildcard sits beside the named arms.
   189	fn match_block_regions(source: &str) -> Vec<String> {
   190	    let mut regions = Vec::new();
   191	    for (start, _) in source.match_indices("match block {") {
   192	        let rest = &source[start..];
   193	        // The region ends at the first line that closes the match at its own indentation.
   194	        let end = rest
   195	            .find("\n        }")
   196	            .or_else(|| rest.find("\n    }"))
   197	            .unwrap_or(rest.len());
   198	        // Comments are dropped first. Every named arm here carries a comment that explains
   199	        // the drop, and one of them writes `_ => {}` to name what it avoids. The first
   200	        // version of this guard read that prose as code and failed the build for it.
   201	        let code: String = rest[..end]
   202	            .lines()
   203	            .filter(|line| !line.trim_start().starts_with("//"))
   204	            .collect::<Vec<_>>()
   205	            .join("\n");
   206	        regions.push(code);
   207	    }
   208	    regions
   209	}
   210	
   211	/// Every request builder names every content block. A stream parser may keep a wildcard,
   212	/// because a wire event set is open, but a request builder must not: that is how a reasoning
   213	/// block was dropped in silence, and how Azure kept dropping one for a whole sprint.
   214	#[test]
   215	fn every_request_builder_has_an_explicit_arm() {
   216	    for path in [
   217	        "../rho-provider-bedrock/src/lib.rs",
   218	        "../rho-provider-openrouter/src/lib.rs",
   219	        "../rho-provider-azure/src/lib.rs",
   220	    ] {
   221	        let source = std::fs::read_to_string(path).expect("the provider source reads");
   222	        let production = source
   223	            .split("#[cfg(test)]")
   224	            .next()
   225	            .expect("a source file has a first part");
   226	        for block in [
   227	            "ContentBlock::ReasoningTrace",
   228	            "ContentBlock::ReasoningReplay",
   229	            "ContentBlock::Image",
   230	        ] {
   231	            assert!(
   232	                production.contains(block),
   233	                "{path} must name {block} in an arm of its own"
   234	            );
   235	        }
   236	        // Naming the blocks is not enough. A wildcard beside them takes the traffic and
   237	        // the named arms become decoration. A deliberate break proved that: it added
   238	        // `_ => {}` and kept every name, and the first version of this guard passed. So
   239	        // the match over a content block is now read arm by arm.
   240	        for region in match_block_regions(production) {
   241	            assert!(
   242	                !region.contains("_ => {}") && !region.contains("_ => {"),
   243	                "{path} has a wildcard in a match over a content block:\n{region}"
   244	            );
   245	        }
   246	    }
   247	}
