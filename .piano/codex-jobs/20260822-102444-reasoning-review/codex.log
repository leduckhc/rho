    58	/// One typed unit of message content.
    59	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
    60	#[serde(from = "DiskBlock", into = "DiskBlock")]
    61	pub enum ContentBlock {
    62	    /// Plain assistant or user text.
    63	    Text { text: String },
    64	    /// Readable reasoning, kept for the reader. **It never reaches a provider.**
    65	    ReasoningTrace { text: String },
    66	    /// Reasoning a provider needs echoed back. `state` is `None` when there is nothing to
    67	    /// replay, and the block is then history with a name that says it could travel.
    68	    ReasoningReplay {
    69	        text: String,
    70	        state: Option<ProviderState>,
