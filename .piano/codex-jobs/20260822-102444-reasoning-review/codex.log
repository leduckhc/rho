     1	//! The session log. An append-only JSONL record of one conversation.
     2	//!
     3	//! See `SPEC-sessions`, `ADR-session-format`, and `ADR-jsonl-codec`. This module holds the record set, the
     4	//! codec seam, the writer, the reader, the store, and the event recorder.
     5	//!
     6	//! Stage T4 defined the public surface. Stage T5 made every body real.
     7	
     8	use std::collections::{HashMap, HashSet};
     9	use std::fs::{File, OpenOptions};
    10	use std::io::{BufRead, BufReader, Write};
    11	use std::path::{Path, PathBuf};
    12	use std::time::{SystemTime, UNIX_EPOCH};
    13	
    14	use serde::de::DeserializeOwned;
    15	use serde::{Deserialize, Serialize};
    16	
    17	use crate::{AgentEvent, AgentStopReason, ContentBlock, Message, Role, StreamEvent, Usage};
    18	
    19	// ---------------------------------------------------------------------------
    20	// Section 2. The record set.
    21	// ---------------------------------------------------------------------------
    22	
    23	/// A record id. A short, unique string, minted per record.
    24	#[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]
    25	pub struct RecordId(pub String);
    26	
    27	/// One line of the session file. The shared fields sit beside the tagged body, so
    28	/// the on-disk shape is `{ "type": ..., "id": ..., "parentId": ..., "timestamp": ..., ... }`.
    29	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
    30	pub struct Entry {
    31	    pub id: RecordId,
    32	    #[serde(rename = "parentId")]
    33	    pub parent_id: Option<RecordId>,
    34	    /// The record time, as epoch milliseconds in a decimal string, for example
    35	    /// `1750890000785`. One session file holds this one format on every line, so a
    36	    /// consumer never guesses per line. The pi import converts a pi RFC 3339 timestamp
    37	    /// into this format, so an imported file matches a native file.
    38	    pub timestamp: String,
    39	    #[serde(flatten)]
    40	    pub record: Record,
    41	}
    42	
    43	/// The body of one record. The `type` tag selects the variant.
    44	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
    45	#[serde(tag = "type", rename_all = "snake_case")]
    46	pub enum Record {
    47	    /// The header. The first record. One per file. `approval` and `sandbox` name
    48	    /// the resolved modes the session ran under. See section 8a.
    49	    Session {
    50	        version: u32,
    51	        cwd: PathBuf,
    52	        approval: String,
    53	        sandbox: String,
    54	    },
    55	    /// The provider or the model changed.
    56	    ModelChange { provider: String, model: String },
    57	    /// One conversation message. It carries the redacted content.
    58	    Message { message: Message },
    59	    /// Cumulative usage after a turn.
    60	    Usage { usage: Usage },
    61	    /// The run stopped, with a reason.
    62	    Stop {
    63	        #[serde(rename = "reason")]
    64	        stop_reason: AgentStopReason,
    65	    },
    66	    /// The session closed cleanly. The last record of a closed file, unless a resume
    67	    /// reopened it. Then a `Reopened` record follows, and nothing else may.
    68	    Closed,
    69	    /// A resume reopened a closed session.
    70	    ///
    71	    /// A closed file ends with `Closed`. A resume may still append, because a user may
    72	    /// continue a conversation they closed. So the reopen is stated on disk. Without this
    73	    /// record a reader would find `Closed` in the middle of a file, and it could not tell
    74	    /// a closed session from one that kept talking. See `SPEC-sessions` section 8.
    75	    Reopened,
    76	}
    77	
    78	/// The largest single record written to the file, in bytes.
    79	pub const MAX_RECORD_BYTES: usize = 64 * 1024;
    80	
    81	// ---------------------------------------------------------------------------
    82	// Section 3. The codec seam.
    83	// ---------------------------------------------------------------------------
    84	
    85	/// Encode one record to a single JSONL line. It adds no trailing newline.
    86	pub fn encode<T: Serialize>(value: &T) -> Result<String, SessionError> {
    87	    #[cfg(not(feature = "fast-json"))]
    88	    {
    89	        serde_json::to_string(value).map_err(|e| SessionError::Encode(e.to_string()))
    90	    }
    91	    #[cfg(feature = "fast-json")]
    92	    {
    93	        sonic_rs::to_string(value).map_err(|e| SessionError::Encode(e.to_string()))
    94	    }
    95	}
    96	
    97	/// Decode one JSONL line to a record.
    98	pub fn decode<T: DeserializeOwned>(line: &str) -> Result<T, SessionError> {
    99	    #[cfg(not(feature = "fast-json"))]
   100	    {
   101	        serde_json::from_str(line).map_err(|e| SessionError::Decode(e.to_string()))
   102	    }
   103	    #[cfg(feature = "fast-json")]
   104	    {
   105	        sonic_rs::from_str(line).map_err(|e| SessionError::Decode(e.to_string()))
   106	    }
   107	}
   108	
   109	// ---------------------------------------------------------------------------
   110	// Section 4. The writer, the reader, and the store.
   111	// ---------------------------------------------------------------------------
   112	
   113	/// The session header, without the shared record fields.
   114	#[derive(Clone, Debug, PartialEq)]
   115	pub struct SessionHeader {
   116	    pub version: u32,
   117	    pub session_id: String,
   118	    pub cwd: PathBuf,
   119	    /// The resolved approval mode name. One of `read-only`, `ask`, `allow-all`.
   120	    pub approval: String,
   121	    /// The resolved sandbox mode name. One of `off`, `confined`, `strict`.
   122	    pub sandbox: String,
   123	}
   124	
   125	/// The largest single line a reader accepts, in bytes. A longer line is a decode
   126	/// error, never an allocation. See section 6a.
   127	pub const MAX_LINE_BYTES: usize = 8 * 1024 * 1024;
   128	
   129	/// A typed session error.
   130	#[derive(Debug, thiserror::Error)]
   131	pub enum SessionError {
   132	    #[error("session io error: {0}")]
   133	    Io(String),
   134	    #[error("cannot encode a record: {0}")]
   135	    Encode(String),
   136	    #[error("cannot decode a record: {0}")]
   137	    Decode(String),
   138	    #[error("unsupported session version {0}")]
   139	    Version(u32),
   140	    /// A resume would widen a permission, and the user did not allow it.
   141	    #[error(
   142	        "a resume would widen {field} from {stored} to {requested}; pass --allow-widen to allow it"
   143	    )]
   144	    Widen {
   145	        field: &'static str,
   146	        stored: String,
   147	        requested: String,
   148	    },
   149	}
   150	
   151	/// The approval modes, ordered from strict to permissive.
   152	///
   153	/// The order is the whole point. It makes a widening resume representable as a
   154	/// refusal. See `SPEC-sessions` section 8a.
   155	#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
   156	pub enum StoredApproval {
   157	    ReadOnly,
   158	    Ask,
   159	    AllowAll,
   160	}
   161	
   162	/// The sandbox modes, ordered from strict to permissive.
   163	#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
   164	pub enum StoredSandbox {
   165	    Strict,
   166	    Confined,
   167	    Off,
   168	}
   169	
   170	impl StoredApproval {
   171	    /// Parse a stored name. An unknown name is the strictest mode, never the loosest.
   172	    pub fn parse(name: &str) -> Self {
   173	        match name {
   174	            "ask" => StoredApproval::Ask,
   175	            "allow-all" => StoredApproval::AllowAll,
   176	            // `read-only`, and every name this build does not know, is the strictest
   177	            // mode. An unknown name must never widen a permission. See D-plugin-does-not-classify-itself.
   178	            _ => StoredApproval::ReadOnly,
   179	        }
   180	    }
   181	
   182	    /// The stored name of this mode.
   183	    fn name(self) -> &'static str {
   184	        match self {
   185	            StoredApproval::ReadOnly => "read-only",
   186	            StoredApproval::Ask => "ask",
   187	            StoredApproval::AllowAll => "allow-all",
   188	        }
   189	    }
   190	}
   191	
   192	impl StoredSandbox {
   193	    /// Parse a stored name. An unknown name is the strictest mode, never the loosest.
   194	    pub fn parse(name: &str) -> Self {
   195	        match name {
   196	            "confined" => StoredSandbox::Confined,
   197	            "off" => StoredSandbox::Off,
   198	            // `strict`, and every unknown name, is the strictest mode. See D-plugin-does-not-classify-itself.
   199	            _ => StoredSandbox::Strict,
   200	        }
   201	    }
   202	
   203	    /// The stored name of this mode.
   204	    fn name(self) -> &'static str {
   205	        match self {
   206	            StoredSandbox::Strict => "strict",
   207	            StoredSandbox::Confined => "confined",
   208	            StoredSandbox::Off => "off",
   209	        }
   210	    }
   211	}
   212	
   213	/// Compare the stored modes in a header against the modes this run would use.
   214	///
   215	/// Return `Ok(())` when the run keeps or narrows both modes. Return
   216	/// `SessionError::Widen` when the run would widen either mode and `allow_widen` is
   217	/// false. Return `Ok(())` for a wider run when `allow_widen` is true, because the user
   218	/// asked for it on purpose.
   219	pub fn check_resume_permission(
   220	    header: &SessionHeader,
   221	    approval: StoredApproval,
   222	    sandbox: StoredSandbox,
   223	    allow_widen: bool,
   224	) -> Result<(), SessionError> {
   225	    if allow_widen {
   226	        return Ok(());
   227	    }
   228	    // A larger value is a more permissive mode, because both enums order from strict to
   229	    // permissive. So a requested mode greater than the stored mode is a widen.
   230	    let stored_approval = StoredApproval::parse(&header.approval);
   231	    if approval > stored_approval {
   232	        return Err(SessionError::Widen {
   233	            field: "approval",
   234	            stored: stored_approval.name().to_string(),
   235	            requested: approval.name().to_string(),
   236	        });
   237	    }
   238	    let stored_sandbox = StoredSandbox::parse(&header.sandbox);
   239	    if sandbox > stored_sandbox {
   240	        return Err(SessionError::Widen {
   241	            field: "sandbox",
   242	            stored: stored_sandbox.name().to_string(),
   243	            requested: sandbox.name().to_string(),
   244	        });
   245	    }
   246	    Ok(())
   247	}
   248	
   249	/// Appends records to one session file. It owns an open sink and mints ids.
   250	///
   251	/// The writer holds one sink for the life of the session, and writes one record as one
   252	/// write. It never reopens the file and never rewrites an earlier byte. See `SPEC-sessions`
   253	/// section 3. A held handle costs about 1 microsecond per record, against about 17.5
   254	/// microseconds for a reopen per record, measured on macos arm64 over 20000 records.
   255	///
   256	/// The sink is a seam. `SessionStore` passes an open file. A test passes a sink that
   257	/// fails on demand, which proves the degrade path without removing the session
   258	/// directory. This mirrors `SessionReader::read_from`, the reader seam.
   259	pub struct SessionWriter {
   260	    path: PathBuf,
   261	    sink: Box<dyn Write + Send>,
   262	    head: Option<RecordId>,
   263	    next_id: u64,
   264	    closed: bool,
   265	}
   266	
   267	impl SessionWriter {
   268	    /// Build a writer over any sink. The store passes an open file. A test passes a
   269	    /// sink that fails on demand, to prove the degrade path. See `SPEC-sessions` section 3
   270	    /// and decision D-write-failure-degrades.
   271	    pub fn with_sink(path: impl Into<PathBuf>, sink: Box<dyn Write + Send>) -> Self {
   272	        Self {
   273	            path: path.into(),
   274	            sink,
   275	            head: None,
   276	            next_id: 0,
   277	            closed: false,
   278	        }
   279	    }
   280	
   281	    /// Mint the next record id. The ids are unique within one file.
   282	    fn mint_id(&mut self) -> RecordId {
   283	        let id = RecordId(format!("r{}", self.next_id));
   284	        self.next_id += 1;
   285	        id
   286	    }
   287	
   288	    /// The sidecar path for one record, next to the session file.
   289	    fn sidecar_path(&self, id: &RecordId) -> PathBuf {
   290	        let stem = self
   291	            .path
   292	            .file_stem()
   293	            .map(|s| s.to_string_lossy().into_owned())
   294	            .unwrap_or_else(|| "session".to_string());
   295	        self.path.with_file_name(format!("{stem}.{}.sidecar", id.0))
   296	    }
   297	
   298	    /// Write one already-built entry as a single line. One record is one write, so the
   299	    /// line and its newline go to the sink in one call. It appends and never rewrites.
   300	    fn write_entry(&mut self, entry: &Entry) -> Result<(), SessionError> {
   301	        let mut bytes = encode(entry)?.into_bytes();
   302	        bytes.push(b'\n');
   303	        self.sink
   304	            .write_all(&bytes)
   305	            .map_err(|e| io_error(self.path.as_path(), e))?;
   306	        self.sink
   307	            .flush()
   308	            .map_err(|e| io_error(self.path.as_path(), e))?;
   309	        Ok(())
   310	    }
   311	
   312	    /// Append one record. Mint an id. Link the parent. Stamp the time. Write one
   313	    /// line. Flush. Return the new id. Never rewrite an earlier byte.
   314	    pub fn append(
   315	        &mut self,
   316	        record: Record,
   317	        parent: Option<RecordId>,
   318	    ) -> Result<RecordId, SessionError> {
   319	        let id = self.mint_id();
   320	        let timestamp = now_timestamp();
   321	        let entry = Entry {
   322	            id: id.clone(),
   323	            parent_id: parent.clone(),
   324	            timestamp: timestamp.clone(),
   325	            record,
   326	        };
   327	        let line = encode(&entry)?;
   328	        let entry = if line.len() > MAX_RECORD_BYTES {
   329	            // The record is over the cap. Cap the oversize string values, spill the full
   330	            // payload to a sidecar, and rebuild the entry from the capped record. See
   331	            // SPEC-sessions section 3 and D-cap-a-large-tool-result.
   332	            let mut spills = Vec::new();
   333	            let capped = cap_record(entry.record, &mut spills);
   334	            if !spills.is_empty() {
   335	                self.spill_to_sidecar(&id, &spills)?;
   336	            }
   337	            Entry {
   338	                id: id.clone(),
   339	                parent_id: parent,
   340	                timestamp,
   341	                record: capped,
   342	            }
   343	        } else {
   344	            entry
   345	        };
   346	        self.write_entry(&entry)?;
   347	        self.head = Some(id.clone());
   348	        Ok(id)
   349	    }
   350	
   351	    /// Write the spilled payloads for one record to a sidecar file.
   352	    fn spill_to_sidecar(&self, id: &RecordId, spills: &[String]) -> Result<(), SessionError> {
   353	        let path = self.sidecar_path(id);
   354	        let mut file = File::create(&path).map_err(|e| io_error(path.as_path(), e))?;
   355	        for spill in spills {
   356	            file.write_all(spill.as_bytes())
   357	                .map_err(|e| io_error(path.as_path(), e))?;
   358	            file.write_all(b"\n")
   359	                .map_err(|e| io_error(path.as_path(), e))?;
   360	        }
   361	        file.flush().map_err(|e| io_error(path.as_path(), e))?;
   362	        Ok(())
   363	    }
   364	
   365	    /// The id of the last record written. A later append links to it by default.
   366	    pub fn head(&self) -> Option<RecordId> {
   367	        self.head.clone()
   368	    }
   369	
   370	    /// The file path.
   371	    pub fn path(&self) -> &Path {
   372	        &self.path
   373	    }
   374	
   375	    /// Write the `Closed` record. Idempotent. A second call writes nothing.
   376	    pub fn close(&mut self) -> Result<(), SessionError> {
   377	        if self.closed {
   378	            return Ok(());
   379	        }
   380	        let parent = self.head.clone();
   381	        self.append(Record::Closed, parent)?;
   382	        self.closed = true;
   383	        Ok(())
   384	    }
   385	}
   386	
   387	/// Build an io error that names the path that failed.
   388	///
   389	/// A bare os message says "No such file or directory" and never says which file. A user
   390	/// with 500 sessions learns nothing from that. So every io error names its path, exactly
   391	/// as `ConfigError::Read` does.
   392	fn io_error(path: &Path, error: std::io::Error) -> SessionError {
   393	    SessionError::Io(format!("{}: {error}", path.display()))
   394	}
   395	
   396	/// The session format version this build reads and writes.
   397	const SESSION_FORMAT_VERSION: u32 = 1;
   398	
   399	/// The largest byte length of one string value kept inline in a capped record. A longer
   400	/// value spills to a sidecar and leaves a head plus a note in its place.
   401	const STRING_HEAD_LIMIT: usize = 4 * 1024;
   402	
   403	/// The record time, as epoch milliseconds in a decimal string. One session file holds
   404	/// this one timestamp format on every line, so a consumer never guesses per line. The
   405	/// pi import converts an RFC 3339 timestamp into this format. `rho-core` adds no date
   406	/// dependency, because a date crate for one field is not worth the tree.
   407	fn now_timestamp() -> String {
   408	    let millis = SystemTime::now()
   409	        .duration_since(UNIX_EPOCH)
   410	        .map(|d| d.as_millis())
   411	        .unwrap_or(0);
   412	    format!("{millis}")
   413	}
   414	
   415	/// The largest byte length of any string value inside a JSON value.
   416	fn max_json_string(value: &serde_json::Value) -> usize {
   417	    match value {
   418	        serde_json::Value::String(s) => s.len(),
   419	        serde_json::Value::Array(items) => items.iter().map(max_json_string).max().unwrap_or(0),
   420	        serde_json::Value::Object(map) => map.values().map(max_json_string).max().unwrap_or(0),
   421	        _ => 0,
   422	    }
   423	}
   424	
   425	/// The head of a string, cut on a character boundary at or below `limit` bytes.
   426	fn utf8_head(text: &str, limit: usize) -> &str {
   427	    let mut end = limit.min(text.len());
   428	    while end > 0 && !text.is_char_boundary(end) {
   429	        end -= 1;
   430	    }
   431	    &text[..end]
   432	}
   433	
   434	/// Replace an oversize string with a head plus a note that states the full byte count.
   435	fn cap_string_value(text: &str) -> String {
   436	    format!(
   437	        "{}\u{2026} [rho capped a value of {} bytes; the full payload is in a sidecar file]",
   438	        utf8_head(text, STRING_HEAD_LIMIT),
   439	        text.len()
   440	    )
   441	}
   442	
   443	/// Cap oversize string values inside a JSON value, in place of the tree. The full value
   444	/// is spilled by the caller, so this only shrinks the inline copy.
   445	fn cap_json_strings(value: serde_json::Value) -> serde_json::Value {
   446	    match value {
   447	        serde_json::Value::String(s) if s.len() > STRING_HEAD_LIMIT => {
   448	            serde_json::Value::String(cap_string_value(&s))
   449	        }
   450	        serde_json::Value::Array(items) => {
   451	            serde_json::Value::Array(items.into_iter().map(cap_json_strings).collect())
   452	        }
   453	        serde_json::Value::Object(map) => serde_json::Value::Object(
   454	            map.into_iter()
   455	                .map(|(k, v)| (k, cap_json_strings(v)))
   456	                .collect(),
   457	        ),
   458	        other => other,
   459	    }
   460	}
   461	
   462	/// Cap one content block. It keeps the block kind, so a `ToolCall` stays a `ToolCall`.
   463	fn cap_block(block: ContentBlock, spills: &mut Vec<String>) -> ContentBlock {
   464	    match block {
   465	        ContentBlock::Text { text } if text.len() > STRING_HEAD_LIMIT => {
   466	            let capped = cap_string_value(&text);
   467	            spills.push(text);
   468	            ContentBlock::Text { text: capped }
   469	        }
   470	        ContentBlock::ToolResult {
   471	            tool_call_id,
   472	            content,
   473	            is_error,
   474	        } => ContentBlock::ToolResult {
   475	            tool_call_id,
   476	            content: content.into_iter().map(|b| cap_block(b, spills)).collect(),
   477	            is_error,
   478	        },
   479	        ContentBlock::ToolCall {
   480	            id,
   481	            name,
   482	            arguments,
   483	            state,
   484	        } if max_json_string(&arguments) > STRING_HEAD_LIMIT => {
   485	            // A `ToolCall` is never rewritten to a text note. Keep the id and the name,
   486	            // spill the full arguments, and cap the oversize string values inside them.
   487	            spills.push(arguments.to_string());
   488	            ContentBlock::ToolCall {
   489	                id,
   490	                name,
   491	                arguments: cap_json_strings(arguments),
   492	                state: cap_state(state),
   493	            }
   494	        }
   495	        ContentBlock::ToolCall {
   496	            id,
   497	            name,
   498	            arguments,
   499	            state,
   500	        } => ContentBlock::ToolCall {
   501	            id,
   502	            name,
   503	            arguments,
   504	            state: cap_state(state),
   505	        },
   506	        // Reasoning text is capped exactly as assistant text is. A named arm, because a
   507	        // wildcard here let a new block join the file uncapped. See rule 10.
   508	        ContentBlock::ReasoningTrace { text } if text.len() > STRING_HEAD_LIMIT => {
   509	            let capped = cap_string_value(&text);
   510	            spills.push(text);
   511	            ContentBlock::ReasoningTrace { text: capped }
   512	        }
   513	        ContentBlock::ReasoningTrace { text } => ContentBlock::ReasoningTrace { text },
   514	        ContentBlock::ReasoningReplay { text, state } => {
   515	            let state = cap_state(state);
   516	            if text.len() > STRING_HEAD_LIMIT {
   517	                let capped = cap_string_value(&text);
   518	                spills.push(text);
   519	                ContentBlock::ReasoningReplay {
   520	                    text: capped,
   521	                    state,
   522	                }
   523	            } else {
   524	                ContentBlock::ReasoningReplay { text, state }
   525	            }
   526	        }
   527	        other => other,
   528	    }
   529	}
   530	
   531	/// Bound one replay payload. Rule 10: a payload over `MAX_RECORD_BYTES` is dropped whole.
   532	///
   533	/// A payload is opaque, so it cannot be trimmed. Half a signature still looks like a
   534	/// signature and would be replayed as one, and a record that cannot be read back makes the
   535	/// whole session unresumable. So the answer is all or nothing, and the drop is reported.
   536	fn cap_state(state: Option<crate::ProviderState>) -> Option<crate::ProviderState> {
   537	    let state = state?;
   538	    let size = serde_json::to_string(&state.value).map(|text| text.len());
   539	    match size {
   540	        Ok(size) if size <= MAX_RECORD_BYTES => Some(state),
   541	        Ok(size) => {
   542	            // The report names the size and the owner, and never the value, per rule 9. It
   543	            // is a log line and not a spill, because a spilled payload cannot be replayed
   544	            // from a sidecar and would only carry opaque bytes into a second file.
   545	            tracing::warn!(
   546	                provider = %state.owner.provider,
   547	                size,
   548	                "a reasoning payload exceeded the record cap and was dropped"
   549	            );
   550	            None
   551	        }
   552	        // A value that cannot be encoded cannot be written either, so it goes the same way.
   553	        Err(_) => {
   554	            tracing::warn!("a reasoning payload could not be encoded and was dropped");
   555	            None
   556	        }
   557	    }
   558	}
   559	
   560	/// Cap one record so its encoded line fits `MAX_RECORD_BYTES`. Only a `Message` carries
   561	/// free-form text or arguments, so only a `Message` needs a cap.
   562	fn cap_record(record: Record, spills: &mut Vec<String>) -> Record {
   563	    match record {
   564	        Record::Message { message } => Record::Message {
   565	            message: Message {
   566	                role: message.role,
   567	                content: message
   568	                    .content
   569	                    .into_iter()
   570	                    .map(|b| cap_block(b, spills))
   571	                    .collect(),
   572	            },
   573	        },
   574	        other => other,
   575	    }
   576	}
