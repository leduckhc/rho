   411	        use aws_config::BehaviorVersion;
   412	        use aws_sdk_bedrockruntime::Client;
   413	        use aws_sdk_bedrockruntime::config::Region;
   414	
   415	        // The standard credential chain signs with SigV4: environment, shared
   416	        // profile, SSO cache, then IMDS. The provider never signs by hand.
