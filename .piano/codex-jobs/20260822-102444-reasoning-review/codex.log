   152	#[cfg(test)]
   153	mod effort_tests {
   154	    use super::*;
   155	
   156	    // The effort level. See SPEC-reasoning-across-providers section 9.
   157	
   158	    #[test]
   159	    fn every_effort_name_round_trips() {
   160	        for effort in [
   161	            ReasoningEffort::Off,
   162	            ReasoningEffort::Low,
   163	            ReasoningEffort::Medium,
   164	            ReasoningEffort::High,
   165	            ReasoningEffort::XHigh,
   166	        ] {
   167	            assert_eq!(ReasoningEffort::from_str(effort.as_str()), Ok(effort));
   168	        }
   169	    }
   170	
   171	    #[test]
   172	    fn an_unknown_effort_name_is_an_error() {
   173	        let error = ReasoningEffort::from_str("hard").unwrap_err();
   174	        // The message names the valid levels, so a user can fix it without the docs.
   175	        assert!(
   176	            error.contains("xhigh"),
   177	            "the error names the levels: {error}"
   178	        );
   179	    }
