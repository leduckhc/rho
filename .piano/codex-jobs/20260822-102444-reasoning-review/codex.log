   450	/// The working directory, with the home directory shortened to `~`.
   451	fn display_cwd() -> String {
   452	    let cwd = std::env::current_dir().unwrap_or_default();
   453	    let text = cwd.to_string_lossy().to_string();
   454	    match std::env::var("HOME") {
   455	        Ok(home) if !home.is_empty() && text.starts_with(&home) => text.replacen(&home, "~", 1),
   456	        _ => text,
   457	    }
   458	}
