    31	/// rho is a composable coding agent harness.
    32	#[derive(Debug, Parser)]
    33	#[command(name = "rho", version, about = "A composable coding agent harness.")]
    34	pub struct Cli {
    35	    /// The provider to use. It beats the RHO_PROVIDER variable, through the merge.
    36	    ///
    37	    /// No `env` attribute here. Layer 5 belongs to the merge, and a clap `env` would be a
    38	    /// second precedence beside it. See `SPEC-config` section 2.
    39	    #[arg(long, global = true)]
    40	    pub provider: Option<String>,
    41	
    42	    /// The model id to send. It beats the RHO_MODEL variable, through the merge.
    43	    #[arg(long, global = true)]
    44	    pub model: Option<String>,
    45	
    46	    /// The profile to apply. A profile is a named block in a config file.
    47	    ///
    48	    /// Layer 4 selects a profile, so without this flag no file profile is reachable.
    49	    #[arg(long, global = true, value_name = "NAME")]
    50	    pub profile: Option<String>,
    51	
    52	    /// The session root. Tools cannot touch a path outside it. Defaults to the
    53	    /// current directory.
    54	    #[arg(long, global = true)]
    55	    pub root: Option<PathBuf>,
    56	
    57	    /// Deny every tool that can change state. rho then reads, searches, and
    58	    /// thinks, but it does not write, edit, or run a command.
    59	    ///
    60	    /// It is `Option<bool>` so that an unpassed flag writes nothing into layer 6. A plain
    61	    /// `bool` would send `false` and beat an `approval` key in a file. It maps onto
    62	    /// `approval = "read-only"`, so the flag wins by the merge order and needs no
    63	    /// special case.
    64	    #[arg(long, global = true, num_args = 0..=1, default_missing_value = "true")]
    65	    pub read_only: Option<bool>,
    66	
    67	    /// The `bash` confinement mode. `off` runs a command unconfined, which is the
    68	    /// default. `confined` limits writes to the session root and the scratch
    69	    /// directory. `strict` also denies the network. When confinement is asked for
    70	    /// and no OS sandbox is available, `bash` refuses the command. See SPEC-bash-sandbox.
    71	    ///
    72	    /// It carries no `default_value_t`. A clap default would always yield `Off`, so layer 6
    73	    /// would beat a file asking for `sandbox = "strict"`. That is a fail-open inside the
    74	    /// merge built to prevent one. The default now lives in `Config::defaults`.
    75	    #[arg(long, global = true, value_enum)]
    76	    pub sandbox: Option<SandboxArg>,
    77	
    78	    /// Let the TUI capture the mouse, so the wheel scrolls the band and a click
    79	    /// selects a list row.
    80	    ///
    81	    /// Off by default, because capture takes drag-select away from the terminal. With
    82	    /// capture off, the wheel, a drag, and the terminal search all work on the
    83	    /// transcript. See decision D-native-selection-is-the-default.
    84	    #[arg(long, global = true, num_args = 0..=1, default_missing_value = "true")]
    85	    pub mouse: Option<bool>,
    86	
    87	    /// How the TUI draws reasoning: `off`, `summary`, `full`, or `live`.
    88	    ///
    89	    /// Default is `summary`, a one-row `∴ thought for 2.4s`. `full` also draws the
    90	    /// reasoning text, dimmed. `live` draws the text while it streams, then collapses it.
    91	    /// `off` hides reasoning entirely. See `SPEC-reasoning-across-providers`.
    92	    #[arg(long, global = true)]
    93	    pub reasoning: Option<String>,
    94	
    95	    /// How hard the model thinks: `off`, `low`, `medium`, `high`, or `xhigh`.
    96	    ///
    97	    /// Unset means the provider's own default, so rho sends no field. The level is the
    98	    /// user's word: a Claude model gets a token budget, and an OpenAI-compatible host gets
    99	    /// the word. A model that cannot think is asked for nothing. See
   100	    /// `SPEC-reasoning-across-providers` section 9.
   101	    #[arg(long, global = true)]
   102	    pub reasoning_effort: Option<String>,
   103	
   104	    /// Load skills that live in this repository.
   105	    ///
   106	    /// A skill can instruct the model and can carry scripts, so a skill from the
   107	    /// repository under edit is off by default. See decision D-project-skill-needs-trust.
   108	    #[arg(long, global = true)]
   109	    pub trust_project: bool,
   110	
   111	    /// Load a skill from this path. Repeatable. It loads even with --no-skills.
   112	    #[arg(long = "skill", global = true, value_name = "PATH")]
   113	    pub skills: Vec<PathBuf>,
   114	
   115	    /// Do not search the skill directories. An explicit --skill still loads.
   116	    #[arg(long, global = true, num_args = 0..=1, default_missing_value = "true")]
   117	    pub no_skills: Option<bool>,
   118	
   119	    /// Read MCP servers from this file instead of ~/.rho/mcp.json.
   120	    #[arg(long, global = true, value_name = "PATH")]
   121	    pub mcp_config: Option<PathBuf>,
   122	
   123	    /// The log filter, for example "info" or "rho_core=debug". It beats RHO_LOG.
   124	    #[arg(long, global = true)]
   125	    pub log: Option<String>,
   126	
   127	    #[command(subcommand)]
   128	    pub command: Option<Command>,
   129	}
