   754	/// Assembles the assistant message from a turn's stream events. It closes each
   755	/// content block on its `*End` event, in `index` order.
   756	#[derive(Default)]
   757	struct AssistantBuilder {
   758	    content: Vec<ContentBlock>,
   759	    tool_calls: Vec<PendingToolCall>,
   760	    text: Option<String>,
   761	    thinking: Option<String>,
   762	    tool_call: Option<(String, String)>,
   763	}
   764	
   765	impl AssistantBuilder {
   766	    /// Fold one stream event into the message under construction.
   767	    fn observe(&mut self, event: &StreamEvent) {
   768	        match event {
   769	            StreamEvent::TextStart { .. } => self.text = Some(String::new()),
   770	            StreamEvent::TextDelta { delta, .. } => {
   771	                if let Some(text) = self.text.as_mut() {
   772	                    text.push_str(delta);
   773	                }
   774	            }
   775	            StreamEvent::TextEnd { .. } => {
   776	                if let Some(text) = self.text.take() {
   777	                    self.content.push(ContentBlock::Text { text });
   778	                }
   779	            }
   780	            StreamEvent::ThinkingStart { .. } => self.thinking = Some(String::new()),
   781	            StreamEvent::ThinkingDelta { delta, .. } => {
   782	                if let Some(thinking) = self.thinking.as_mut() {
   783	                    thinking.push_str(delta);
   784	                }
   785	            }
   786	            // A payload makes the block replayable. Without one it is history for the
   787	            // reader, and the type stops it reaching a provider at all.
   788	            StreamEvent::ThinkingEnd { state, .. } => {
   789	                if let Some(text) = self.thinking.take() {
   790	                    self.content.push(match state {
   791	                        Some(state) => ContentBlock::ReasoningReplay {
   792	                            text,
   793	                            state: Some(state.clone()),
   794	                        },
   795	                        None => ContentBlock::ReasoningTrace { text },
   796	                    });
   797	                }
   798	            }
   799	            StreamEvent::ToolCallStart { id, name, .. } => {
   800	                self.tool_call = Some((id.clone(), name.clone()));
   801	            }
   802	            StreamEvent::ToolCallEnd {
   803	                arguments, state, ..
   804	            } => {
   805	                if let Some((id, name)) = self.tool_call.take() {
   806	                    self.content.push(ContentBlock::ToolCall {
   807	                        id: id.clone(),
   808	                        name: name.clone(),
   809	                        arguments: arguments.clone(),
   810	                        state: state.clone(),
   811	                    });
   812	                    self.tool_calls.push(PendingToolCall {
   813	                        id,
   814	                        name,
   815	                        arguments: arguments.clone(),
   816	                    });
   817	                }
   818	            }
   819	            StreamEvent::MessageStart { .. }
   820	            | StreamEvent::ToolCallDelta { .. }
   821	            | StreamEvent::Usage(_)
   822	            | StreamEvent::Done { .. } => {}
   823	        }
   824	    }
   825	
    25	    },
    26	    TextDelta {
    27	        index: u32,
    28	        delta: String,
    29	    },
    30	    TextEnd {
    31	        index: u32,
    32	    },
    33	    ThinkingStart {
    34	        index: u32,
    35	    },
    36	    ThinkingDelta {
    37	        index: u32,
    38	        delta: String,
    39	    },
    40	    ThinkingEnd {
