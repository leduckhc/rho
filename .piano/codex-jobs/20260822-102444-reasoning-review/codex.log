   502	/// Convert one SDK `ConverseStreamOutput` into the recorded mirror. The mirror
   503	/// then flows through the same `map_converse_event` the tests exercise.
   504	fn sdk_event_to_mirror(
   505	    event: aws_sdk_bedrockruntime::types::ConverseStreamOutput,
   506	) -> Option<ConverseStreamEvent> {
   507	    use aws_sdk_bedrockruntime::types::{
   508	        ContentBlockDelta as SdkDelta, ContentBlockStart as SdkStart, ConverseStreamOutput as Out,
   509	        ReasoningContentBlockDelta as SdkReasoning,
   510	    };
   511	
   512	    let mut mirror = ConverseStreamEvent {
   513	        message_start: None,
   514	        content_block_start: None,
   515	        content_block_delta: None,
   516	        content_block_stop: None,
   517	        message_stop: None,
   518	        metadata: None,
   519	    };
   520	
   521	    match event {
   522	        Out::MessageStart(start) => {
   523	            mirror.message_start = Some(MessageStart {
   524	                role: start.role.as_str().to_string(),
   525	            });
   526	        }
   527	        Out::ContentBlockStart(start) => {
   528	            let tool_use = match start.start {
   529	                Some(SdkStart::ToolUse(tool)) => Some(ToolUseStart {
   530	                    tool_use_id: tool.tool_use_id,
   531	                    name: tool.name,
   532	                }),
   533	                _ => None,
   534	            };
   535	            mirror.content_block_start = Some(ContentBlockStart {
   536	                content_block_index: start.content_block_index.max(0) as u32,
   537	                start: BlockStart { tool_use },
   538	            });
   539	        }
   540	        Out::ContentBlockDelta(delta) => {
   541	            let block_delta = match delta.delta {
   542	                Some(SdkDelta::Text(text)) => BlockDelta {
   543	                    text: Some(text),
   544	                    tool_use: None,
   545	                    reasoning_content: None,
   546	                },
   547	                Some(SdkDelta::ToolUse(tool)) => BlockDelta {
   548	                    text: None,
   549	                    tool_use: Some(ToolUseDelta { input: tool.input }),
   550	                    reasoning_content: None,
   551	                },
   552	                Some(SdkDelta::ReasoningContent(SdkReasoning::Text(text))) => BlockDelta {
   553	                    text: None,
   554	                    tool_use: None,
   555	                    reasoning_content: Some(ReasoningDelta {
   556	                        text: Some(text),
   557	                        signature: None,
   558	                        redacted_content: None,
   559	                    }),
   560	                },
   561	                // The signature arrives in its own delta, after the text. This arm was a
   562	                // wildcard, so the live path dropped every signature and rho had nothing to
   563	                // replay. The unit tests could not see it, because they build the mirror
   564	                // shape directly.
   565	                Some(SdkDelta::ReasoningContent(SdkReasoning::Signature(signature))) => {
   566	                    BlockDelta {
   567	                        text: None,
   568	                        tool_use: None,
   569	                        reasoning_content: Some(ReasoningDelta {
   570	                            text: None,
   571	                            signature: Some(signature),
   572	                            redacted_content: None,
   573	                        }),
   574	                    }
   575	                }
   576	                // Encrypted reasoning. It is opaque, and it replays as it arrived. The blob
   577	                // is not valid UTF-8 in general, so it is carried as base64.
   578	                Some(SdkDelta::ReasoningContent(SdkReasoning::RedactedContent(blob))) => {
   579	                    use base64::Engine;
   580	                    BlockDelta {
   581	                        text: None,
   582	                        tool_use: None,
   583	                        reasoning_content: Some(ReasoningDelta {
   584	                            text: None,
   585	                            signature: None,
   586	                            redacted_content: Some(
   587	                                base64::engine::general_purpose::STANDARD.encode(blob.as_ref()),
   588	                            ),
   589	                        }),
   590	                    }
   591	                }
   592	                _ => BlockDelta {
   593	                    text: None,
   594	                    tool_use: None,
   595	                    reasoning_content: None,
   596	                },
   597	            };
   598	            mirror.content_block_delta = Some(ContentBlockDelta {
   599	                content_block_index: delta.content_block_index.max(0) as u32,
   600	                delta: block_delta,
   601	            });
   602	        }
   603	        Out::ContentBlockStop(stop) => {
   604	            mirror.content_block_stop = Some(ContentBlockStop {
   605	                content_block_index: stop.content_block_index.max(0) as u32,
   606	            });
   607	        }
   608	        Out::MessageStop(stop) => {
   609	            mirror.message_stop = Some(MessageStop {
   610	                stop_reason: stop.stop_reason.as_str().to_string(),
   611	            });
   612	        }
   613	        Out::Metadata(metadata) => {
   614	            let usage = metadata.usage?;
   615	            mirror.metadata = Some(Metadata {
   616	                usage: BedrockUsage {
   617	                    input_tokens: usage.input_tokens.max(0) as u64,
   618	                    output_tokens: usage.output_tokens.max(0) as u64,
   619	                    cache_read_input_tokens: usage.cache_read_input_tokens.unwrap_or(0).max(0)
   620	                        as u64,
   621	                    cache_write_input_tokens: usage.cache_write_input_tokens.unwrap_or(0).max(0)
   622	                        as u64,
   623	                },
   624	            });
   625	        }
   626	        _ => return None,
   627	    }
   628	    Some(mirror)
   629	}
