   936	/// Convert a JSON value into the AWS `Document` type the SDK uses.
   937	fn json_to_document(value: &Value) -> Document {
   938	    match value {
   939	        Value::Null => Document::Null,
   940	        Value::Bool(flag) => Document::Bool(*flag),
   941	        Value::Number(number) => {
   942	            if let Some(unsigned) = number.as_u64() {
   943	                Document::Number(Number::PosInt(unsigned))
   944	            } else if let Some(signed) = number.as_i64() {
   945	                Document::Number(Number::NegInt(signed))
   946	            } else {
   947	                Document::Number(Number::Float(number.as_f64().unwrap_or(0.0)))
   948	            }
   949	        }
   950	        Value::String(text) => Document::String(text.clone()),
   951	        Value::Array(items) => Document::Array(items.iter().map(json_to_document).collect()),
   952	        Value::Object(map) => Document::Object(
   953	            map.iter()
   954	                .map(|(key, inner)| (key.clone(), json_to_document(inner)))
   955	                .collect(),
   956	        ),
   957	    }
   958	}
