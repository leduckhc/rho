   596	/// Reads a session file into records.
   597	pub struct SessionReader;
   598	
   599	/// Read one line into `buf`, up to `MAX_LINE_BYTES`. Return `true` when a line was read,
   600	/// `false` at end of input. A line that reaches the cap is a `SessionError::Decode`,
   601	/// never an unbounded allocation, and the reader stops before it pulls the whole line.
   602	/// See section 6a and D-reader-line-cap.
   603	fn read_capped_line<R: BufRead>(source: &mut R, buf: &mut Vec<u8>) -> Result<bool, SessionError> {
   604	    buf.clear();
   605	    loop {
   606	        let available = match source.fill_buf() {
   607	            Ok(bytes) => bytes,
   608	            Err(e) => return Err(SessionError::Io(e.to_string())),
   609	        };
   610	        if available.is_empty() {
   611	            return Ok(!buf.is_empty());
   612	        }
   613	        if let Some(pos) = available.iter().position(|&b| b == b'\n') {
   614	            if buf.len() + pos + 1 > MAX_LINE_BYTES {
   615	                return Err(SessionError::Decode(format!(
   616	                    "a session line exceeds {MAX_LINE_BYTES} bytes"
   617	                )));
   618	            }
   619	            buf.extend_from_slice(&available[..=pos]);
   620	            source.consume(pos + 1);
     1	//! The rules that govern a replay payload: the log rule, the bound, and the report.
     2	//!
     3	//! See `SPEC-reasoning-across-providers` section 4 and rules 8 to 11, and decision
     4	//! `D-reasoning-replay-is-opaque-provider-state`.
     5	
     6	use std::sync::{Arc, Mutex};
     7	
     8	use rho_core::{ContentBlock, ProviderState, ReasoningOwner, SessionLog};
     9	
    10	/// A writer that collects every log byte into a shared buffer.
    11	#[derive(Clone)]
    12	struct BufferWriter(Arc<Mutex<Vec<u8>>>);
    13	
    14	impl std::io::Write for BufferWriter {
    15	    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
    16	        self.0.lock().unwrap().extend_from_slice(buf);
    17	        Ok(buf.len())
    18	    }
    19	    fn flush(&mut self) -> std::io::Result<()> {
    20	        Ok(())
    21	    }
    22	}
    23	
    24	impl<'a> tracing_subscriber::fmt::MakeWriter<'a> for BufferWriter {
    25	    type Writer = BufferWriter;
    26	    fn make_writer(&'a self) -> Self::Writer {
    27	        self.clone()
    28	    }
    29	}
    30	
    31	fn state(value: serde_json::Value) -> ProviderState {
    32	    ProviderState {
    33	        owner: ReasoningOwner {
    34	            provider: "bedrock".to_string(),
    35	            model: "claude".to_string(),
    36	        },
    37	        value,
    38	    }
    39	}
    40	
    41	/// Write one message through the recorder, and return every line of the session file.
    42	///
    43	/// The block travels the real write path: `redact_block`, then `cap_record`. It goes in as a
    44	/// prompt, because that is the one entry point the recorder exposes for a message, and the
    45	/// two functions under test do not care about the role.
    46	///
    47	/// **No production caller writes a session file yet.** See
    48	/// `D-no-caller-writes-a-session-file`. These tests cover the format, and they claim nothing
    49	/// about a lifecycle that has no caller.
    50	fn recorded(block: ContentBlock) -> Vec<String> {
    51	    let dir = tempfile::tempdir().expect("a temp dir");
    52	    let store = rho_core::SessionStore::new(dir.path());
    53	    let writer = store
    54	        .create("test-session", dir.path(), "allow-all", "off")
    55	        .expect("the session file opens");
    56	    let path = writer.path().to_path_buf();
    57	    let mut recorder = rho_core::SessionRecorder::new(SessionLog::File(writer));
    58	    recorder.record_prompt(&[block]);
    59	    drop(recorder);
    60	    std::fs::read_to_string(&path)
    61	        .expect("the file reads")
    62	        .lines()
    63	        .map(str::to_string)
    64	        .collect()
    65	}
    66	
    67	/// Rule 9. The payload is exempt from redaction, so it must never reach a log instead.
    68	#[test]
    69	fn a_state_value_never_reaches_a_log() {
    70	    let buffer = Arc::new(Mutex::new(Vec::<u8>::new()));
    71	    let subscriber = tracing_subscriber::fmt()
    72	        .with_writer(BufferWriter(Arc::clone(&buffer)))
    73	        .with_max_level(tracing::Level::TRACE)
    74	        .finish();
    75	    tracing::subscriber::with_default(subscriber, || {
    76	        let block = ContentBlock::ReasoningReplay {
    77	            text: "a plan".to_string(),
    78	            state: Some(state(serde_json::json!({ "signature": "sig-do-not-log" }))),
    79	        };
    80	        let lines = recorded(block);
    81	        assert!(
    82	            lines.iter().any(|line| line.contains("sig-do-not-log")),
    83	            "the payload is stored verbatim, because a rewritten payload cannot replay"
    84	        );
    85	        // Prove the capture works before trusting an empty result. See
    86	        // `D-log-capture-proves-itself`.
    87	        tracing::warn!("the capture is live");
    88	    });
    89	    let logged = String::from_utf8(buffer.lock().unwrap().clone()).expect("valid utf8");
    90	    assert!(logged.contains("the capture is live"), "the capture works");
    91	    assert!(
    92	        !logged.contains("sig-do-not-log"),
    93	        "no payload in a log, at any level: {logged}"
    94	    );
    95	}
