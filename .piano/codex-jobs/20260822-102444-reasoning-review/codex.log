   910	/// Build the tool configuration from the advertised tools.
   911	fn build_tool_config(
   912	    request: &CompletionRequest,
   913	) -> Option<aws_sdk_bedrockruntime::types::ToolConfiguration> {
   914	    use aws_sdk_bedrockruntime::types::{
   915	        Tool, ToolConfiguration, ToolInputSchema, ToolSpecification,
   916	    };
   917	
   918	    if request.tools.is_empty() {
   919	        return None;
   920	    }
   921	    let mut builder = ToolConfiguration::builder();
   922	    for spec in &request.tools {
   923	        let Ok(specification) = ToolSpecification::builder()
   924	            .name(spec.name.clone())
   925	            .description(spec.description.clone())
   926	            .input_schema(ToolInputSchema::Json(json_to_document(&spec.input_schema)))
   927	            .build()
   928	        else {
   929	            continue;
   930	        };
   931	        builder = builder.tools(Tool::ToolSpec(specification));
   932	    }
   933	    builder.build().ok()
   934	}
