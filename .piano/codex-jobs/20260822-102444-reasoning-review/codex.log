   618	/// Map one normalised message to the OpenAI chat message shape.
   619	fn message_to_json(message: &Message) -> Value {
   620	    let role = match message.role {
   621	        Role::User => "user",
   622	        Role::Assistant => "assistant",
   623	        Role::Tool => "tool",
   624	    };
