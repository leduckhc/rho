   579	#[derive(Clone, Debug)]
   580	pub struct ReadResult {
   581	    pub header: SessionHeader,
   582	    pub entries: Vec<Entry>,
   583	    /// True when the last line was partial and dropped. Resume warns on this.
   584	    pub truncated_tail: bool,
