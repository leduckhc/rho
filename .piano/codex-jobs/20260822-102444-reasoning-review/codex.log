   162	
   163	/// Build a `SessionConfig` from the loaded configuration. State every choice.
   164	fn build_config(config: &rho_config::Config) -> anyhow::Result<SessionConfig> {
   165	    // A model comes from the merge, then the provider's default. Every source the user can
   166	    // set now arrives through `Config`, so this reads one value instead of three.
   167	    //
   168	    // The default is a convenience, not a security choice. Decision D-no-four-argument-session-new removed hidden
   169	    // defaults for the session root and the approval policy, because a wrong value there is
   170	    // a breach. A wrong model id is a bad answer and a small bill.
   171	    //
   172	    // The choice is still reported, so it is never silent.
   173	    let provider_name = provider::resolve_provider_name(config.provider.as_deref(), None)?;
   174	    let model = match config.model.clone() {
   175	        Some(model) => model,
   176	        None => match provider::default_model(&provider_name) {
   177	            Some(model) => {
   178	                eprintln!(
   179	                    "rho: no model given, so using the default for {provider_name}: {model}. \
   180	                     Set --model or {MODEL_ENV} to choose another."
   181	                );
   182	                model.to_string()
   183	            }
   184	            None => {
   185	                return Err(anyhow::anyhow!(
   186	                    "no model was chosen, and {provider_name} has no default. \
   187	                     Set --model or the {MODEL_ENV} variable. For azure, the value is your \
   188	                     deployment name."
   189	                ));
   190	            }
   191	        },
   192	    };
   193	
   194	    // The session root confines every tool path. It comes from the merge, and the current
   195	    // directory is the stated default.
   196	    let root = match config.session_root.clone() {
   197	        Some(path) => path,
   198	        None => std::env::current_dir()
   199	            .map_err(|error| anyhow::anyhow!("cannot read the current directory: {error}"))?,
   200	    };
   201	
   202	    // State the approval policy out loud. See decision D-no-four-argument-session-new, which deleted a
   203	    // constructor that hid this choice.
   204	    //
   205	    // The default approves every tool call, so a headless run never stops for a
   206	    // prompt. `--read-only` swaps in a policy that denies every mutating tool. That
   207	    // policy is fail-closed: it allows only a kind it names, so a tool with an
   208	    // undeclared kind is denied. See decision D-todo-in-a-green-stage, and D-plugin-does-not-classify-itself for plugin tools,
   209	    // which always count as mutating.
   210	    //
   211	    // A future release adds an interactive approval gate for the TUI. Until then
   212	    // `--read-only` is the way to run rho against a repository you do not trust.
   213	    // The approval policy comes from the merge. `None` means the user stated none, and the
   214	    // stated default here is permissive so a headless run never stops for a prompt. See
   215	    // decision D-no-four-argument-session-new, which deleted a constructor that hid this choice.
   216	    //
   217	    // `Ask` is refused rather than downgraded. There is no interactive gate in this path, so
   218	    // honouring it would either deny every write in silence or approve every write in
   219	    // silence. Both are worse than saying so. `SPEC-approval` owns the real gate.
   220	    let approval: Arc<dyn ApprovalPolicy> = match config.approval {
   221	        Some(rho_config::ApprovalMode::ReadOnly) => Arc::new(ReadOnlyPolicy),
   222	        Some(rho_config::ApprovalMode::AllowAll) | None => Arc::new(AllowAllPolicy),
   223	        Some(rho_config::ApprovalMode::Ask) => {
   224	            return Err(anyhow::anyhow!(
   225	                "approval = \"ask\" needs an interactive frontend, which this build does not \
   226	                 have here. Use read-only or allow-all, or pass --read-only."
   227	            ));
   228	        }
   229	    };
   230	
   231	    Ok(SessionConfig::new(model, root, approval)
   232	        .with_sandbox(config.sandbox)
   233	        .with_reasoning_effort(config.reasoning_effort))
   234	}
