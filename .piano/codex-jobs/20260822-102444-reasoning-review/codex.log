   640	    let loaded = match load_config(cli) {
   641	        Ok(loaded) => loaded,
   642	        Err(error) => return fail(error),
   643	    };
   644	    let config = match build_config(&loaded) {
   645	        Ok(config) => config,
   646	        Err(error) => return fail(error),
   647	    };
   648	    let model = config.model.clone();
   649	    let provider_name = provider::resolve_provider_name(loaded.provider.as_deref(), None)
   650	        .unwrap_or_else(|_| String::new());
   651	    // The interface reads the merged configuration, so a config file reaches both switches.
   652	    let mouse = loaded.tui_mouse;
   653	    let reasoning = loaded.reasoning;
   654	    // Hold `_tasks` and `_extras` for the whole run. Dropping the task registry kills
   655	    // every background task, and dropping the MCP pool stops every server, so an early
   656	    // drop would end work the model is still waiting on.
   657	    let (session, _tasks, extras) = match build_session(cli, &loaded, config).await {
   658	        Ok(triple) => triple,
   659	        Err(error) => return fail(error),
   660	    };
   661	    for notice in &extras.notices {
   662	        eprintln!("rho: {notice}");
   663	    }
   664	    let _extras = extras;
   665	
   666	    // The banner names where this session runs. Without it the banner drew separators
   667	    // around three empty fields, because nothing ever wrote them.
   668	    let cwd = display_cwd();
   669	    let branch = git_branch();
   670	    let mut app = rho_tui::App::new(session, model)
   671	        .with_mouse(mouse)
   672	        .with_reasoning(reasoning)
   673	        .with_context(cwd, branch, provider_name);
   674	    match app.run().await {
   675	        Ok(()) => 0,
   676	        Err(error) => fail(anyhow::anyhow!(error)),
   677	    }
   678	}
