    43	impl ProviderState {
    44	    /// The payload, but only for its own owner. `None` for anybody else.
    45	    ///
    46	    /// Rule 8 lives here, in one place, so no provider hand-rolls the comparison. fx keeps
    47	    /// the same kind of payload with no owner at all, and its own code cannot tell one
    48	    /// provider's payload from another's.
    49	    pub fn for_owner(&self, provider: &str, model: &str) -> Option<&serde_json::Value> {
    50	        if self.owner.provider == provider && self.owner.model == model {
    51	            Some(&self.value)
    52	        } else {
    53	            None
    54	        }
    55	    }
    56	}
