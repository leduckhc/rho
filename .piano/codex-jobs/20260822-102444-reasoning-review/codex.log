    29	/// One provider's own replay payload. Shared code never reads inside `value`.
    30	///
    31	/// `value` holds opaque provider bytes: a signature, an encrypted blob, an item id, or a
    32	/// status. **No readable text.** Readable text lives in the block's `text`, where the
    33	/// session cap and the reader both reach it. That is what makes the redaction exemption of
    34	/// rule 9 safe. See `D-reasoning-replay-is-opaque-provider-state`.
    35	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
    36	pub struct ProviderState {
    37	    /// The pair that may read the value.
    38	    pub owner: ReasoningOwner,
    39	    /// The provider's private shape.
    40	    pub value: serde_json::Value,
    41	}
