   732	/// Map a provider stop reason onto an agent stop reason. See SPEC-core-runtime section 9.
   733	fn map_stop_reason(reason: StopReason) -> AgentStopReason {
   734	    match reason {
   735	        StopReason::EndTurn | StopReason::StopSequence => AgentStopReason::EndTurn,
   736	        StopReason::MaxTokens => AgentStopReason::MaxTokens,
   737	        StopReason::ContentFiltered => AgentStopReason::Refusal,
   738	        StopReason::Canceled => AgentStopReason::Canceled,
   739	        // A `ToolUse` stop is not terminal. The loop handles it before this call.
   740	        StopReason::ToolUse => AgentStopReason::EndTurn,
   741	    }
   742	}
