    41	/// Write one message through the recorder, and return every line of the session file.
    42	///
    43	/// The block travels the real write path: `redact_block`, then `cap_record`. It goes in as a
    44	/// prompt, because that is the one entry point the recorder exposes for a message, and the
    45	/// two functions under test do not care about the role.
    46	///
    47	/// **No production caller writes a session file yet.** See
    48	/// `D-no-caller-writes-a-session-file`. These tests cover the format, and they claim nothing
    49	/// about a lifecycle that has no caller.
    50	fn recorded(block: ContentBlock) -> Vec<String> {
    51	    let dir = tempfile::tempdir().expect("a temp dir");
    52	    let store = rho_core::SessionStore::new(dir.path());
    53	    let writer = store
    54	        .create("test-session", dir.path(), "allow-all", "off")
    55	        .expect("the session file opens");
    56	    let path = writer.path().to_path_buf();
    57	    let mut recorder = rho_core::SessionRecorder::new(SessionLog::File(writer));
    58	    recorder.record_prompt(&[block]);
    59	    drop(recorder);
    60	    std::fs::read_to_string(&path)
    61	        .expect("the file reads")
    62	        .lines()
    63	        .map(str::to_string)
    64	        .collect()
    65	}
    66	
    67	/// Rule 9. The payload is exempt from redaction, so it must never reach a log instead.
    68	#[test]
    69	fn a_state_value_never_reaches_a_log() {
    70	    let buffer = Arc::new(Mutex::new(Vec::<u8>::new()));
    71	    let subscriber = tracing_subscriber::fmt()
    72	        .with_writer(BufferWriter(Arc::clone(&buffer)))
    73	        .with_max_level(tracing::Level::TRACE)
    74	        .finish();
    75	    tracing::subscriber::with_default(subscriber, || {
    76	        let block = ContentBlock::ReasoningReplay {
    77	            text: "a plan".to_string(),
    78	            state: Some(state(serde_json::json!({ "signature": "sig-do-not-log" }))),
    79	        };
    80	        let lines = recorded(block);
    81	        assert!(
    82	            lines.iter().any(|line| line.contains("sig-do-not-log")),
    83	            "the payload is stored verbatim, because a rewritten payload cannot replay"
    84	        );
    85	        // Prove the capture works before trusting an empty result. See
    86	        // `D-log-capture-proves-itself`.
    87	        tracing::warn!("the capture is live");
    88	    });
    89	    let logged = String::from_utf8(buffer.lock().unwrap().clone()).expect("valid utf8");
    90	    assert!(logged.contains("the capture is live"), "the capture works");
    91	    assert!(
    92	        !logged.contains("sig-do-not-log"),
    93	        "no payload in a log, at any level: {logged}"
    94	    );
    95	}
