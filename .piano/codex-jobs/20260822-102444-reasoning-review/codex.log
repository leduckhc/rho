    92	/// The on-disk shape of a content block. One `thinking` record carries both reasoning
    93	/// variants.
    94	///
    95	/// Two enum variants **cannot** share one serde tag. Both compile, and the reader then
    96	/// returns the first one every time, so a replay block came back as a trace with no error.
    97	/// A compile proved that before any code shipped. See
    98	/// `D-two-variants-cannot-share-a-serde-tag`.
    99	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
   100	#[serde(tag = "type", rename_all = "snake_case")]
   101	enum DiskBlock {
   102	    Text {
   103	        text: String,
   104	    },
   105	    Thinking {
   106	        thinking: String,
   107	        /// `true` for a replay block. A missing key reads as `false`, which never replays.
   108	        #[serde(default, skip_serializing_if = "is_false")]
   109	        replay: bool,
   110	        #[serde(default, skip_serializing_if = "Option::is_none")]
   111	        state: Option<ProviderState>,
   112	        /// Read from a file written before the split, and never written again.
   113	        #[serde(default, skip_serializing_if = "Option::is_none")]
   114	        signature: Option<String>,
   115	    },
   116	    ToolCall {
   117	        id: String,
   118	        name: String,
   119	        arguments: serde_json::Value,
   120	        #[serde(default, skip_serializing_if = "Option::is_none")]
   121	        state: Option<ProviderState>,
   122	    },
   123	    ToolResult {
   124	        tool_call_id: String,
   125	        content: Vec<ContentBlock>,
   126	        #[serde(default)]
   127	        is_error: bool,
   128	    },
   129	    Image {
   130	        source: ImageSource,
   131	    },
   132	}
   133	
   134	fn is_false(value: &bool) -> bool {
   135	    !*value
   136	}
