   422	
   423	        let mut builder = client
   424	            .converse_stream()
   425	            .model_id(request.model.clone())
   426	            .set_messages(Some(build_messages_for_model(
   427	                &request.messages,
   428	                &request.model,
   429	            )));
   430	        if let Some(system) = &request.system {
   431	            builder = builder.system(aws_sdk_bedrockruntime::types::SystemContentBlock::Text(
   432	                system.clone(),
   433	            ));
   434	        }
   435	        if let Some(config) = build_inference_config(&request) {
   436	            builder = builder.inference_config(config);
   437	        }
   438	        if let Some(fields) = build_thinking_fields(&request) {
   439	            builder = builder.additional_model_request_fields(fields);
   440	        }
   441	        if let Some(tools) = build_tool_config(&request) {
   442	            builder = builder.tool_config(tools);
   443	        }
