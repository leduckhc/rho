   143	/// The configuration one `Session` needs before it can run.
   144	///
   145	/// It carries the model id, the confinement root, the approval policy, and the
   146	/// per-run turn cap. `Session` holds no default for any of these. A caller states
   147	/// each value, so a security boundary is never set by accident. See decision
   148	/// D-session-config.
   149	#[derive(Clone)]
   150	pub struct SessionConfig {
   151	    /// The model id sent in every `CompletionRequest`. An empty id fails at the
   152	    /// provider with a useless message, so the caller must set a real id.
   153	    pub model: String,
   154	    /// The path confinement root. Every tool resolves its paths under this root.
   155	    /// It has no default. A caller states it.
   156	    pub session_root: PathBuf,
   157	    /// The approval policy. Tool dispatch consults it before it runs a tool.
   158	    pub approval: Arc<dyn ApprovalPolicy>,
   159	    /// The per-run turn cap. The loop stops with `MaxTurnRequests` at the cap.
   160	    pub max_turns: u32,
   161	    /// The `bash` confinement mode. `SessionConfig::new` sets `Off`, so the
   162	    /// default is stated here, not hidden. Use `with_sandbox` to change it. See
   163	    /// `SPEC-bash-sandbox` and decision D-bash-os-sandbox.
   164	    pub sandbox: SandboxMode,
   165	    /// How hard the model should think. `None` means the provider's own default, so rho
   166	    /// sends no field. `SessionConfig::new` leaves it `None`, and a caller opts in with
   167	    /// `with_reasoning_effort`. See `SPEC-reasoning-across-providers` section 9.
   168	    pub reasoning_effort: Option<crate::ReasoningEffort>,
   169	}
   170	
   171	impl SessionConfig {
   172	    /// Build a config with an explicit model, root, and policy. The turn cap uses
   173	    /// the `AgentConfig` default.
   174	    pub fn new(
   175	        model: impl Into<String>,
   176	        session_root: impl Into<PathBuf>,
   177	        approval: Arc<dyn ApprovalPolicy>,
   178	    ) -> Self {
   179	        Self {
   180	            model: model.into(),
   181	            session_root: session_root.into(),
   182	            approval,
   183	            max_turns: AgentConfig::default().max_turns,
   184	            // State the default out loud. `Off` runs `bash` unconfined, which is
   185	            // today's behaviour. A caller opts in with `with_sandbox`.
   186	            sandbox: SandboxMode::Off,
   187	            // No level means no field on the wire, so a host keeps its own default.
   188	            reasoning_effort: None,
   189	        }
   190	    }
   191	
   192	    /// Build a config that confines paths to the current directory. This states
   193	    /// the choice in the calling code, so a current-directory root is never an
   194	    /// accident. It fails when the current directory cannot be read.
   195	    pub fn for_current_dir(
   196	        model: impl Into<String>,
   197	        approval: Arc<dyn ApprovalPolicy>,
   198	    ) -> std::io::Result<Self> {
   199	        Ok(Self::new(model, std::env::current_dir()?, approval))
   200	    }
   201	
   202	    /// Override the per-run turn cap.
   203	    pub fn with_max_turns(mut self, max_turns: u32) -> Self {
   204	        self.max_turns = max_turns;
   205	        self
   206	    }
   207	
   208	    /// Set the `bash` confinement mode. `new` leaves it `Off`. See `SPEC-bash-sandbox`.
   209	    pub fn with_sandbox(mut self, sandbox: SandboxMode) -> Self {
   210	        self.sandbox = sandbox;
   211	        self
   212	    }
   213	
   214	    /// Set how hard the model should think. `new` leaves it unset, which sends no field.
   215	    pub fn with_reasoning_effort(mut self, effort: Option<crate::ReasoningEffort>) -> Self {
   216	        self.reasoning_effort = effort;
   217	        self
   218	    }
   219	}
   220	
   221	pub struct Session {
   222	    inner: Arc<SessionInner>,
   223	}
   224	
   225	struct SessionInner {
   226	    provider: Arc<dyn Provider>,
   227	    tools: Arc<ToolRegistry>,
   228	    hooks: Arc<HookChain>,
   229	    context: tokio::sync::Mutex<Context>,
   230	    config: SessionConfig,
   231	}
   232	
   233	impl Session {
   234	    /// Build a session with an explicit `SessionConfig`. This is the primary
   235	    /// constructor. See decision D-session-config.
   236	    pub fn with_config(
   237	        config: SessionConfig,
   238	        provider: Arc<dyn Provider>,
   239	        tools: Arc<ToolRegistry>,
   240	        hooks: Arc<HookChain>,
   241	        context: Context,
   242	    ) -> Self {
   243	        Self {
   244	            inner: Arc::new(SessionInner {
   245	                provider,
   246	                tools,
   247	                hooks,
   248	                context: tokio::sync::Mutex::new(context),
   249	                config,
   250	            }),
   251	        }
   252	    }
   253	
   254	    /// Build a session with a test configuration. The config confines paths to
   255	    /// the current directory and allows every tool call. Use it in a test where
   256	    /// the model id and the root do not matter. A production caller uses
   257	    /// `with_config` and states a real config.
   258	    /// Start one agent run. Append `input` to the context, then drive the loop.
   259	    /// `cancel` stops the run. Dropping the returned value also stops the run.
   260	    pub fn prompt(&self, input: Vec<ContentBlock>, cancel: CancelToken) -> AgentEvents {
   261	        // The channel carries events from the driver task to the caller. A
   262	        // bounded channel applies backpressure. A dropped receiver makes `send`
   263	        // fail, so the driver task stops on its own.
   264	        let (tx, rx) = tokio::sync::mpsc::channel(EVENT_CHANNEL_CAPACITY);
   265	        let driver = Driver {
   266	            config: AgentConfig {
   267	                max_turns: self.inner.config.max_turns,
   268	            },
   269	            inner: Arc::clone(&self.inner),
   270	            tx,
   271	            cancel,
   272	        };
   273	        let handle = tokio::spawn(driver.run(input));
   274	        AgentEvents { rx, handle }
   275	    }
   276	
   277	    /// Read the conversation so far. The context is append-only, so this returns
   278	    /// a read-only snapshot. A lock guards the context, so this clones the
   279	    /// messages instead of borrowing them.
   280	    pub async fn messages(&self) -> Vec<Message> {
   281	        self.inner.context.lock().await.messages().to_vec()
   282	    }
   283	}
   284	
   285	/// The event channel buffer size. It applies backpressure to the driver task.
   286	const EVENT_CHANNEL_CAPACITY: usize = 64;
   287	
   288	/// The result of one provider turn.
   289	enum TurnOutcome {
   290	    /// The run must stop with this reason.
   291	    Stop(AgentStopReason),
   292	    /// The model asked to call these tools. Run them, then loop.
   293	    ToolCalls(Vec<PendingToolCall>),
   294	    /// The caller cancelled the turn.
   295	    Canceled,
   296	    /// The provider or a tool failed. The error is already sent.
   297	    Failed,
   298	    /// The caller dropped the event stream.
   299	    Closed,
   300	}
   301	
   302	/// One tool call the model requested in a turn.
   303	struct PendingToolCall {
   304	    id: String,
   305	    name: String,
   306	    arguments: serde_json::Value,
   307	}
   308	
   309	/// The task that drives one agent run.
   310	struct Driver {
   311	    inner: Arc<SessionInner>,
   312	    tx: tokio::sync::mpsc::Sender<Result<AgentEvent, Error>>,
   313	    cancel: CancelToken,
   314	    config: AgentConfig,
   315	}
   316	
   317	impl Driver {
   318	    /// Drive the whole run. Append the user input, then run turns until a stop.
   319	    async fn run(self, input: Vec<ContentBlock>) {
   320	        {
   321	            let mut context = self.inner.context.lock().await;
   322	            context.append(Message {
   323	                role: Role::User,
   324	                content: input,
   325	            });
   326	        }
   327	
   328	        let mut turns = 0u32;
   329	        let stop_reason = loop {
   330	            if self.cancel.is_cancelled() {
   331	                // The cancel landed before this turn started. Emit a paired
   332	                // `TurnStart` and `TurnEnd`, so a frontend never sees an
   333	                // unpaired `TurnEnd`. See the tests in agent_loop.rs.
   334	                if self.emit(AgentEvent::TurnStart).await.is_err() {
   335	                    return;
   336	                }
   337	                if self
   338	                    .emit(AgentEvent::TurnEnd {
   339	                        stop_reason: StopReason::Canceled,
   340	                    })
   341	                    .await
   342	                    .is_err()
   343	                {
   344	                    return;
   345	                }
   346	                break AgentStopReason::Canceled;
   347	            }
   348	            if turns >= self.config.max_turns {
   349	                break AgentStopReason::MaxTurnRequests;
   350	            }
   351	            turns += 1;
   352	
   353	            match self.run_turn().await {
   354	                TurnOutcome::Stop(reason) => break reason,
   355	                TurnOutcome::Canceled => break AgentStopReason::Canceled,
   356	                TurnOutcome::Failed | TurnOutcome::Closed => return,
   357	                TurnOutcome::ToolCalls(calls) => match self.dispatch(calls).await {
   358	                    DispatchOutcome::Continue => continue,
   359	                    DispatchOutcome::Canceled => {
   360	                        if self
   361	                            .emit(AgentEvent::TurnEnd {
   362	                                stop_reason: StopReason::Canceled,
   363	                            })
   364	                            .await
   365	                            .is_err()
   366	                        {
   367	                            return;
   368	                        }
   369	                        break AgentStopReason::Canceled;
   370	                    }
   371	                    DispatchOutcome::Closed => return,
   372	                },
   373	            }
   374	        };
   375	
   376	        let _ = self.emit(AgentEvent::AgentEnd { stop_reason }).await;
   377	    }
   378	
   379	    /// Run one provider turn. Forward each stream event. Build the assistant
   380	    /// message. Append it to the context. Return the next step.
   381	    async fn run_turn(&self) -> TurnOutcome {
   382	        if self.emit(AgentEvent::TurnStart).await.is_err() {
   383	            return TurnOutcome::Closed;
   384	        }
   385	
   386	        let request = self.build_request().await;
   387	        let mut stream = match self
   388	            .inner
   389	            .provider
   390	            .stream(request, self.cancel.clone())
   391	            .await
   392	        {
   393	            Ok(stream) => stream,
   394	            Err(error) => {
   395	                let _ = self.tx.send(Err(Error::from(error))).await;
   396	                return TurnOutcome::Failed;
   397	            }
   398	        };
   399	
   400	        let mut builder = AssistantBuilder::default();
   401	        let mut stop_reason = None;
   402	        loop {
   403	            if self.cancel.is_cancelled() {
   404	                if self
   405	                    .emit(AgentEvent::TurnEnd {
   406	                        stop_reason: StopReason::Canceled,
   407	                    })
   408	                    .await
   409	                    .is_err()
   410	                {
   411	                    return TurnOutcome::Closed;
   412	                }
   413	                return TurnOutcome::Canceled;
   414	            }
   415	
   416	            let next = tokio::select! {
   417	                biased;
   418	                _ = self.cancel.cancelled() => {
   419	                    if self
   420	                        .emit(AgentEvent::TurnEnd {
   421	                            stop_reason: StopReason::Canceled,
   422	                        })
   423	                        .await
   424	                        .is_err()
   425	                    {
   426	                        return TurnOutcome::Closed;
   427	                    }
   428	                    return TurnOutcome::Canceled;
   429	                }
   430	                item = stream.next() => item,
   431	            };
   432	
   433	            match next {
   434	                Some(Ok(event)) => {
   435	                    if let StreamEvent::Done {
   436	                        stop_reason: reason,
   437	                    } = &event
   438	                    {
   439	                        stop_reason = Some(*reason);
   440	                    }
   441	                    builder.observe(&event);
   442	                    if self.emit(AgentEvent::Stream(event)).await.is_err() {
   443	                        return TurnOutcome::Closed;
   444	                    }
   445	                    if stop_reason.is_some() {
   446	                        break;
   447	                    }
   448	                }
   449	                Some(Err(error)) => {
   450	                    let _ = self.tx.send(Err(Error::from(error))).await;
   451	                    return TurnOutcome::Failed;
   452	                }
   453	                None => break,
   454	            }
   455	        }
   456	
   457	        let (message, tool_calls) = builder.finish();
   458	        {
   459	            let mut context = self.inner.context.lock().await;
   460	            context.append(message);
   461	        }
   462	
   463	        match stop_reason {
   464	            Some(StopReason::ToolUse) => {
   465	                // Close the turn before the tools run. Every other exit path emits
   466	                // `TurnEnd`, and this one used to skip it, so a tool-calling turn left
   467	                // its `TurnStart` unpaired forever.
   468	                //
   469	                // A frontend pairs the two events to track state. `rho-tui` decides
   470	                // whether the agent is running, and `rho-acp` maps the pair onto a
   471	                // session update. An unpaired start leaks that state.
   472	                if self
   473	                    .emit(AgentEvent::TurnEnd {
   474	                        stop_reason: StopReason::ToolUse,
   475	                    })
   476	                    .await
   477	                    .is_err()
   478	                {
   479	                    return TurnOutcome::Closed;
   480	                }
   481	                TurnOutcome::ToolCalls(tool_calls)
   482	            }
   483	            Some(reason) => {
   484	                if self
   485	                    .emit(AgentEvent::TurnEnd {
   486	                        stop_reason: reason,
   487	                    })
   488	                    .await
   489	                    .is_err()
   490	                {
   491	                    return TurnOutcome::Closed;
   492	                }
   493	                TurnOutcome::Stop(map_stop_reason(reason))
   494	            }
   495	            None => {
   496	                if self.cancel.is_cancelled() {
   497	                    if self
   498	                        .emit(AgentEvent::TurnEnd {
   499	                            stop_reason: StopReason::Canceled,
   500	                        })
   501	                        .await
   502	                        .is_err()
   503	                    {
   504	                        return TurnOutcome::Closed;
   505	                    }
   506	                    return TurnOutcome::Canceled;
   507	                }
   508	                // The provider ended the stream with no `Done` event. Report a
   509	                // decode fault so the caller can retry or stop.
   510	                let _ = self
   511	                    .tx
   512	                    .send(Err(Error::from(crate::ProviderError::Decode(
   513	                        "the provider stream ended without a done event".to_string(),
   514	                    ))))
   515	                    .await;
   516	                TurnOutcome::Failed
   517	            }
   518	        }
   519	    }
   520	
   521	    /// Run every requested tool call, one at a time, in call order.
   522	    async fn dispatch(&self, calls: Vec<PendingToolCall>) -> DispatchOutcome {
   523	        for call in calls {
   524	            match self.dispatch_one(call).await {
   525	                DispatchOutcome::Continue => continue,
   526	                other => return other,
   527	            }
   528	        }
   529	        DispatchOutcome::Continue
   530	    }
   531	
   532	    /// Run the hooks, the approval step, and one tool. Append the result.
   533	    async fn dispatch_one(&self, call: PendingToolCall) -> DispatchOutcome {
   534	        if self.cancel.is_cancelled() {
   535	            return DispatchOutcome::Canceled;
   536	        }
   537	
   538	        let PendingToolCall {
   539	            id,
   540	            name,
   541	            mut arguments,
   542	        } = call;
   543	
   544	        // Run `before_tool_call` in registration order. The first block wins.
   545	        let mut blocked: Option<String> = None;
   546	        for hook in self.inner.hooks.hooks() {
   547	            let mut view = ToolCallView {
   548	                name: &name,
   549	                arguments: &mut arguments,
   550	            };
   551	            match hook.before_tool_call(&mut view).await {
   552	                HookOutcome::Continue => {}
   553	                HookOutcome::Block { reason } => {
   554	                    blocked = Some(reason);
   555	                    break;
   556	                }
   557	            }
   558	        }
   559	
   560	        if let Some(reason) = blocked {
   561	            let output = error_output(reason);
   562	            return self.finish_tool(&id, output).await;
   563	        }
   564	
   565	        let tool = self.inner.tools.get(&name).cloned();
   566	        let Some(tool) = tool else {
   567	            let output = error_output(format!("the tool {name} is not registered"));
   568	            return self.finish_tool(&id, output).await;
   569	        };
   570	
   571	        // Consult the approval policy after the hooks. A denial produces an error
   572	        // tool result from the typed `ToolError::Denied` variant. The tool never
   573	        // runs. See SPEC-core-runtime section 9 and SPEC-tool-interface section 5.
   574	        if self
   575	            .inner
   576	            .config
   577	            .approval
   578	            .approve(&name, tool.kind(), &arguments)
   579	            .await
   580	            == ApprovalDecision::Deny
   581	        {
   582	            let output = error_output(ToolError::Denied.to_string());
   583	            return self.finish_tool(&id, output).await;
   584	        }
   585	
   586	        if self
   587	            .emit(AgentEvent::ToolStart {
   588	                id: id.clone(),
   589	                name: name.clone(),
   590	                kind: tool.kind(),
   591	            })
   592	            .await
   593	            .is_err()
   594	        {
   595	            return DispatchOutcome::Closed;
   596	        }
   597	
   598	        // A tool streams output lines on this channel. Forward each line as a
   599	        // `ToolUpdate` while the tool runs.
   600	        let (updates_tx, mut updates_rx) =
   601	            tokio::sync::mpsc::channel::<String>(EVENT_CHANNEL_CAPACITY);
   602	        let context = ToolContext {
   603	            session_root: self.inner.config.session_root.clone(),
   604	            cancel: self.cancel.clone(),
   605	            updates: updates_tx,
   606	        };
   607	        let execute = tool.execute(arguments, context);
   608	        tokio::pin!(execute);
   609	
   610	        let result = loop {
   611	            tokio::select! {
   612	                biased;
   613	                _ = self.cancel.cancelled() => return DispatchOutcome::Canceled,
   614	                line = updates_rx.recv() => {
   615	                    if let Some(line) = line
   616	                        && self
   617	                            .emit(AgentEvent::ToolUpdate {
   618	                                id: id.clone(),
   619	                                output: line,
   620	                            })
   621	                            .await
   622	                            .is_err()
   623	                    {
   624	                        return DispatchOutcome::Closed;
   625	                    }
   626	                }
   627	                done = &mut execute => break done,
   628	            }
   629	        };
   630	
   631	        // Drain any output line the tool sent just before it returned.
   632	        while let Ok(line) = updates_rx.try_recv() {
   633	            if self
   634	                .emit(AgentEvent::ToolUpdate {
   635	                    id: id.clone(),
   636	                    output: line,
   637	                })
   638	                .await
   639	                .is_err()
   640	            {
   641	                return DispatchOutcome::Closed;
   642	            }
   643	        }
   644	        let mut output = match result {
   645	            Ok(output) => output,
   646	            Err(error) => {
   647	                // A tool failure is a result, not the end of the run.
   648	                //
   649	                // A live smoke test found the opposite behaviour. A missing file
   650	                // aborted the whole session, and the model never learned why. That
   651	                // makes the harness unusable, because almost every real session has a
   652	                // tool error: a file is missing, a grep matches nothing, a command
   653	                // exits non-zero. The model must see the failure so it can try
   654	                // something else.
   655	                //
   656	                // Only a transport or provider fault ends a run. A tool error becomes
   657	                // an error tool result, exactly like a blocked call or an unknown tool.
   658	                error_output(error.to_string())
   659	            }
   660	        };
   661	
   662	        // Run `after_tool_result` in registration order. A hook may edit output.
   663	        for hook in self.inner.hooks.hooks() {
   664	            hook.after_tool_result(&name, &mut output).await;
   665	        }
   666	
   667	        self.finish_tool(&id, output).await
   668	    }
   669	
   670	    /// Emit `ToolEnd` and append the tool-result message to the context.
   671	    async fn finish_tool(&self, id: &str, output: ToolOutput) -> DispatchOutcome {
   672	        let message = Message {
   673	            role: Role::Tool,
   674	            content: vec![ContentBlock::ToolResult {
   675	                tool_call_id: id.to_string(),
   676	                content: output.content.clone(),
   677	                is_error: output.is_error,
   678	            }],
   679	        };
   680	        {
   681	            let mut context = self.inner.context.lock().await;
   682	            context.append(message);
   683	        }
   684	        if self
   685	            .emit(AgentEvent::ToolEnd {
   686	                id: id.to_string(),
   687	                output,
   688	            })
   689	            .await
   690	            .is_err()
   691	        {
   692	            return DispatchOutcome::Closed;
   693	        }
   694	        DispatchOutcome::Continue
   695	    }
   696	
   697	    /// Build the next request from the current context. The system prompt and
   698	    /// the tool list form the stable prefix. The messages grow by appending.
   699	    async fn build_request(&self) -> CompletionRequest {
   700	        let context = self.inner.context.lock().await;
   701	        CompletionRequest {
   702	            model: self.inner.config.model.clone(),
   703	            system: context.system().map(str::to_string),
   704	            messages: context.messages().to_vec(),
   705	            tools: self.inner.tools.specs(),
   706	            max_tokens: None,
   707	            temperature: None,
   708	            reasoning: self.inner.config.reasoning_effort,
   709	        }
   710	    }
   711	
   712	    /// Send one event. Return `Err` when the caller dropped the receiver.
   713	    async fn emit(&self, event: AgentEvent) -> Result<(), ()> {
   714	        self.tx.send(Ok(event)).await.map_err(|_| ())
   715	    }
   716	}
   717	
   718	/// The result of running one or more tool calls.
   719	///
   720	/// There is deliberately no `Failed` variant. A tool failure is a result that goes
   721	/// back to the model, not an end to the run. Only a transport or provider fault
   722	/// ends a run. See the tool-error branch in `dispatch_one`.
   723	enum DispatchOutcome {
   724	    /// The loop may run the next turn.
   725	    Continue,
   726	    /// The caller cancelled the run.
   727	    Canceled,
   728	    /// The caller dropped the event stream.
   729	    Closed,
   730	}
   731	
   732	/// Map a provider stop reason onto an agent stop reason. See SPEC-core-runtime section 9.
   733	fn map_stop_reason(reason: StopReason) -> AgentStopReason {
   734	    match reason {
   735	        StopReason::EndTurn | StopReason::StopSequence => AgentStopReason::EndTurn,
   736	        StopReason::MaxTokens => AgentStopReason::MaxTokens,
   737	        StopReason::ContentFiltered => AgentStopReason::Refusal,
   738	        StopReason::Canceled => AgentStopReason::Canceled,
   739	        // A `ToolUse` stop is not terminal. The loop handles it before this call.
   740	        StopReason::ToolUse => AgentStopReason::EndTurn,
   741	    }
   742	}
   743	
   744	/// Build an error tool result that carries a plain-text reason for the model.
   745	fn error_output(reason: impl Into<String>) -> ToolOutput {
   746	    ToolOutput {
   747	        content: vec![ContentBlock::Text {
   748	            text: reason.into(),
   749	        }],
   750	        is_error: true,
   751	    }
   752	}
   753	
   754	/// Assembles the assistant message from a turn's stream events. It closes each
   755	/// content block on its `*End` event, in `index` order.
   756	#[derive(Default)]
   757	struct AssistantBuilder {
   758	    content: Vec<ContentBlock>,
   759	    tool_calls: Vec<PendingToolCall>,
   760	    text: Option<String>,
     1	//! The normalised streaming event.
     2	//!
     3	//! Every provider emits this one event type. Every frontend consumes it. The
     4	//! provider maps its own wire format onto these variants.
     5	
     6	use crate::{Role, Usage};
     7	use serde::{Deserialize, Serialize};
     8	
     9	use crate::StopReason;
    10	
    11	/// A normalised streaming event, provider-agnostic.
    12	///
    13	/// `index` groups events for one content block within the current message.
    14	/// A provider emits a `*Start`, then zero or more `*Delta`, then a `*End` for
    15	/// each block, in `index` order.
    16	#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
    17	#[serde(tag = "kind", rename_all = "snake_case")]
    18	pub enum StreamEvent {
    19	    /// The assistant message begins.
    20	    MessageStart {
    21	        role: Role,
    22	    },
    23	    TextStart {
    24	        index: u32,
    25	    },
    26	    TextDelta {
    27	        index: u32,
    28	        delta: String,
    29	    },
    30	    TextEnd {
    31	        index: u32,
    32	    },
    33	    ThinkingStart {
    34	        index: u32,
    35	    },
    36	    ThinkingDelta {
    37	        index: u32,
    38	        delta: String,
    39	    },
    40	    ThinkingEnd {
    41	        index: u32,
    42	        /// The provider's opaque replay payload, or `None` when it sent none. It replaces
    43	        /// `signature: Option<String>`: a signature now travels inside the payload, so one
    44	        /// carrier covers every provider. See `SPEC-reasoning-across-providers` section 4.
    45	        state: Option<crate::ProviderState>,
    46	    },
    47	    /// A tool call begins. The name is known at the start.
    48	    ToolCallStart {
    49	        index: u32,
    50	        id: String,
    51	        name: String,
    52	    },
    53	    /// A raw JSON fragment of the tool-call arguments.
    54	    ToolCallDelta {
    55	        index: u32,
    56	        delta: String,
    57	    },
    58	    /// The tool call is complete. `arguments` is the parsed JSON object.
    59	    ToolCallEnd {
    60	        index: u32,
    61	        arguments: serde_json::Value,
    62	        /// The replay payload a provider binds to this call, such as Gemini's thought
    63	        /// signature. Without this field a provider could not carry one, and the extension
    64	        /// point of the spec would be a promise rho cannot keep.
    65	        state: Option<crate::ProviderState>,
    66	    },
    67	    /// Cumulative token usage, reported one or more times.
    68	    Usage(Usage),
    69	    /// The turn is done. This is the last event of a successful turn.
    70	    Done {
    71	        stop_reason: StopReason,
    72	    },
    73	}
     1	//! The rules that govern a replay payload: the log rule, the bound, and the report.
     2	//!
     3	//! See `SPEC-reasoning-across-providers` section 4 and rules 8 to 11, and decision
     4	//! `D-reasoning-replay-is-opaque-provider-state`.
     5	
     6	use std::sync::{Arc, Mutex};
     7	
     8	use rho_core::{ContentBlock, ProviderState, ReasoningOwner, SessionLog};
     9	
    10	/// A writer that collects every log byte into a shared buffer.
    11	#[derive(Clone)]
    12	struct BufferWriter(Arc<Mutex<Vec<u8>>>);
    13	
    14	impl std::io::Write for BufferWriter {
    15	    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
    16	        self.0.lock().unwrap().extend_from_slice(buf);
    17	        Ok(buf.len())
    18	    }
    19	    fn flush(&mut self) -> std::io::Result<()> {
    20	        Ok(())
    21	    }
    22	}
    23	
    24	impl<'a> tracing_subscriber::fmt::MakeWriter<'a> for BufferWriter {
    25	    type Writer = BufferWriter;
    26	    fn make_writer(&'a self) -> Self::Writer {
    27	        self.clone()
    28	    }
    29	}
    30	
    31	fn state(value: serde_json::Value) -> ProviderState {
    32	    ProviderState {
    33	        owner: ReasoningOwner {
    34	            provider: "bedrock".to_string(),
    35	            model: "claude".to_string(),
    36	        },
    37	        value,
    38	    }
    39	}
    40	
    41	/// Write one message through the recorder, and return every line of the session file.
    42	///
    43	/// The block travels the real write path: `redact_block`, then `cap_record`. It goes in as a
    44	/// prompt, because that is the one entry point the recorder exposes for a message, and the
    45	/// two functions under test do not care about the role.
    46	///
    47	/// **No production caller writes a session file yet.** See
    48	/// `D-no-caller-writes-a-session-file`. These tests cover the format, and they claim nothing
    49	/// about a lifecycle that has no caller.
    50	fn recorded(block: ContentBlock) -> Vec<String> {
    51	    let dir = tempfile::tempdir().expect("a temp dir");
    52	    let store = rho_core::SessionStore::new(dir.path());
    53	    let writer = store
    54	        .create("test-session", dir.path(), "allow-all", "off")
    55	        .expect("the session file opens");
    56	    let path = writer.path().to_path_buf();
    57	    let mut recorder = rho_core::SessionRecorder::new(SessionLog::File(writer));
    58	    recorder.record_prompt(&[block]);
    59	    drop(recorder);
    60	    std::fs::read_to_string(&path)
    61	        .expect("the file reads")
    62	        .lines()
    63	        .map(str::to_string)
    64	        .collect()
    65	}
    66	
    67	/// Rule 9. The payload is exempt from redaction, so it must never reach a log instead.
    68	#[test]
    69	fn a_state_value_never_reaches_a_log() {
    70	    let buffer = Arc::new(Mutex::new(Vec::<u8>::new()));
    71	    let subscriber = tracing_subscriber::fmt()
    72	        .with_writer(BufferWriter(Arc::clone(&buffer)))
    73	        .with_max_level(tracing::Level::TRACE)
    74	        .finish();
    75	    tracing::subscriber::with_default(subscriber, || {
    76	        let block = ContentBlock::ReasoningReplay {
    77	            text: "a plan".to_string(),
    78	            state: Some(state(serde_json::json!({ "signature": "sig-do-not-log" }))),
    79	        };
    80	        let lines = recorded(block);
    81	        assert!(
    82	            lines.iter().any(|line| line.contains("sig-do-not-log")),
    83	            "the payload is stored verbatim, because a rewritten payload cannot replay"
    84	        );
    85	        // Prove the capture works before trusting an empty result. See
    86	        // `D-log-capture-proves-itself`.
    87	        tracing::warn!("the capture is live");
    88	    });
    89	    let logged = String::from_utf8(buffer.lock().unwrap().clone()).expect("valid utf8");
    90	    assert!(logged.contains("the capture is live"), "the capture works");
    91	    assert!(
    92	        !logged.contains("sig-do-not-log"),
    93	        "no payload in a log, at any level: {logged}"
    94	    );
    95	}
    96	
    97	/// Rule 10. A payload over the record cap is dropped whole, and the drop is reported.
    98	#[test]
    99	fn a_value_over_the_record_cap_is_dropped_and_reported() {
   100	    let buffer = Arc::new(Mutex::new(Vec::<u8>::new()));
   101	    let subscriber = tracing_subscriber::fmt()
   102	        .with_writer(BufferWriter(Arc::clone(&buffer)))
   103	        .with_max_level(tracing::Level::TRACE)
   104	        .finish();
   105	    let joined = tracing::subscriber::with_default(subscriber, || {
   106	        let huge = "x".repeat(rho_core::MAX_RECORD_BYTES + 1);
   107	        let block = ContentBlock::ReasoningReplay {
   108	            text: "a plan".to_string(),
   109	            state: Some(state(serde_json::json!({ "signature": huge }))),
   110	        };
   111	        recorded(block).join("\n")
   112	    });
   113	    assert!(
   114	        !joined.contains(&"x".repeat(1000)),
   115	        "the oversize payload is not written"
   116	    );
   117	    assert!(
   118	        joined.contains("a plan"),
   119	        "the readable text survives the drop"
   120	    );
   121	    let logged = String::from_utf8(buffer.lock().unwrap().clone()).expect("valid utf8");
   122	    // The report names the size and the provider, and never the value.
   123	    assert!(
   124	        logged.contains("exceeded the record cap") && logged.contains("bedrock"),
   125	        "the drop is reported: {logged}"
   126	    );
   127	    assert!(
   128	        !logged.contains(&"x".repeat(1000)),
   129	        "the report never carries the payload"
   130	    );
   131	}
   132	
   133	/// A payload under the cap is written unchanged, or a replay after a resume would fail.
   134	#[test]
   135	fn a_payload_under_the_cap_is_written_verbatim() {
   136	    let block = ContentBlock::ReasoningReplay {
   137	        text: "a plan".to_string(),
   138	        state: Some(state(serde_json::json!({ "signature": "keep-me" }))),
   139	    };
   140	    let joined = recorded(block).join("\n");
   141	    assert!(joined.contains("keep-me"));
   142	    assert!(joined.contains("\"replay\":true"));
   143	}
   144	
   145	/// Rule 11. A record that claims a replay and carries no payload loads as history, and
   146	/// rho says so, because a provider bug must not hide.
   147	#[test]
   148	fn a_replay_record_with_no_state_is_reported() {
   149	    let buffer = Arc::new(Mutex::new(Vec::<u8>::new()));
   150	    let subscriber = tracing_subscriber::fmt()
   151	        .with_writer(BufferWriter(Arc::clone(&buffer)))
   152	        .with_max_level(tracing::Level::TRACE)
   153	        .finish();
   154	    let block: ContentBlock = tracing::subscriber::with_default(subscriber, || {
   155	        serde_json::from_value(serde_json::json!({
   156	            "type": "thinking", "thinking": "x", "replay": true
   157	        }))
   158	        .expect("the record loads")
   159	    });
   160	    assert_eq!(
   161	        block,
