    63	/// `Option<ReasoningEffort>` carries "unset". `None` means the provider's own default, so
    64	/// rho sends no field at all and the host keeps its behaviour. See
    65	/// `SPEC-reasoning-across-providers` section 9.
    66	#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
    67	#[serde(rename_all = "lowercase")]
    68	pub enum ReasoningEffort {
    69	    /// Ask the model not to think. A host with a disable switch gets it. A host without one
    70	    /// gets no field, because rho must not invent a value.
    71	    Off,
    72	    Low,
    73	    Medium,
    74	    High,
    75	    XHigh,
    76	}
    77	
    78	/// The lowest budget Anthropic accepts. A smaller value is a 400 for the whole turn.
    79	pub const MIN_THINKING_BUDGET: u32 = 1024;
    80	
    81	impl ReasoningEffort {
    82	    /// The level name, as the config file, the flag, and the variable accept it.
    83	    pub fn as_str(self) -> &'static str {
    84	        match self {
    85	            ReasoningEffort::Off => "off",
    86	            ReasoningEffort::Low => "low",
    87	            ReasoningEffort::Medium => "medium",
    88	            ReasoningEffort::High => "high",
    89	            ReasoningEffort::XHigh => "xhigh",
    90	        }
    91	    }
    92	
    93	    /// The Anthropic-style token budget for this level. `None` for `Off`.
    94	    ///
    95	    /// The ladder starts at `MIN_THINKING_BUDGET`. The numbers are a starting point, and
    96	    /// section 7 of the spec says a measurement gets its own bench.
    97	    pub fn budget_tokens(self) -> Option<u32> {
    98	        match self {
    99	            ReasoningEffort::Off => None,
   100	            ReasoningEffort::Low => Some(MIN_THINKING_BUDGET),
   101	            ReasoningEffort::Medium => Some(4096),
   102	            ReasoningEffort::High => Some(16_384),
   103	            ReasoningEffort::XHigh => Some(32_768),
   104	        }
   105	    }
   106	}
   107	
   108	impl FromStr for ReasoningEffort {
   109	    type Err = String;
   110	    fn from_str(text: &str) -> Result<Self, Self::Err> {
   111	        match text {
   112	            "off" => Ok(ReasoningEffort::Off),
   113	            "low" => Ok(ReasoningEffort::Low),
   114	            "medium" => Ok(ReasoningEffort::Medium),
   115	            "high" => Ok(ReasoningEffort::High),
   116	            "xhigh" => Ok(ReasoningEffort::XHigh),
   117	            other => Err(format!(
   118	                "unknown reasoning effort \"{other}\": the valid levels are \
   119	                 off, low, medium, high, and xhigh"
   120	            )),
   121	        }
   122	    }
   123	}
