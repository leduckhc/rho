   752	/// Build the inference configuration when the request sets any limit.
   753	/// The provider id every payload carries. It is `Provider::id` for this crate.
   754	const PROVIDER_ID: &str = "bedrock";
   755	
   756	/// The payload for one finished reasoning block, or `None` when the model signed nothing.
   757	///
   758	/// An unsigned block is not replayable. Bedrock rejects a reasoning block without its
   759	/// signature, so rho keeps the text as history instead of sending a block it knows is bad.
   760	fn take_reasoning_state(
   761	    state: &mut BedrockMapState,
   762	    index: u32,
   763	) -> Option<rho_core::ProviderState> {
   764	    let signature = state.signatures.remove(&index);
   765	    let redacted = state.redacted.remove(&index);
   766	    if signature.is_none() && redacted.is_none() {
   767	        return None;
   768	    }
   769	    let mut value = serde_json::Map::new();
   770	    if let Some(signature) = signature {
   771	        value.insert("signature".to_string(), Value::String(signature));
   772	    }
   773	    if let Some(redacted) = redacted {
   774	        value.insert("redacted".to_string(), Value::String(redacted));
   775	    }
   776	    Some(rho_core::ProviderState {
   777	        owner: rho_core::ReasoningOwner {
   778	            provider: PROVIDER_ID.to_string(),
   779	            model: state.model.clone(),
   780	        },
   781	        value: Value::Object(value),
   782	    })
   783	}
   784	
   785	/// Turn one replay payload into a Bedrock reasoning block, when it is ours to replay.
   786	///
   787	/// Rule 8 runs first, through `ProviderState::for_owner`. A payload from another provider or
   788	/// another model is dropped, because a signature is bound to the model that made it.
   789	fn replay_block(
   790	    text: &str,
   791	    state: &Option<rho_core::ProviderState>,
   792	    model: &str,
   793	) -> Option<aws_sdk_bedrockruntime::types::ReasoningContentBlock> {
   794	    use aws_sdk_bedrockruntime::types::{ReasoningContentBlock, ReasoningTextBlock};
   795	
   796	    let value = state.as_ref()?.for_owner(PROVIDER_ID, model)?;
   797	    if let Some(redacted) = value.get("redacted").and_then(Value::as_str) {
   798	        use base64::Engine;
   799	        // The payload holds base64, because a blob is not valid UTF-8 in general. A failed
   800	        // decode sends nothing: a wrong blob is worse than a missing one, because Bedrock
   801	        // would reject the whole turn.
   802	        let bytes = base64::engine::general_purpose::STANDARD
   803	            .decode(redacted)
   804	            .ok()?;
   805	        return Some(ReasoningContentBlock::RedactedContent(
   806	            aws_smithy_types::Blob::new(bytes),
   807	        ));
   808	    }
   809	    let signature = value.get("signature").and_then(Value::as_str)?;
   810	    ReasoningTextBlock::builder()
   811	        .text(text)
   812	        .signature(signature)
   813	        .build()
   814	        .ok()
   815	        .map(ReasoningContentBlock::ReasoningText)
   816	}
   817	
   818	/// Does this model id support Anthropic extended thinking?
   819	///
   820	/// It fails closed. Only a Claude id at version 3.7 or above answers `true`, because a
   821	/// field the endpoint does not know is a 400 for the whole turn. An id rho cannot read is
   822	/// treated as "no". See `SPEC-reasoning-across-providers` section 9 rule 1.
   823	fn model_supports_thinking(model: &str) -> bool {
   824	    let id = model.to_ascii_lowercase();
   825	    // A Bedrock id may carry a region prefix, as in `us.anthropic.claude-...`.
   826	    let Some(after) = id.split("anthropic.claude").nth(1) else {
   827	        return false;
   828	    };
   829	    // The first two numbers after the family name are the version. `claude-3-5-sonnet`
   830	    // gives 3 and 5, and `claude-haiku-4-5-2025...` gives 4 and 5.
   831	    //
   832	    // A version part is always under 100. A release date is not, and
   833	    // `anthropic.claude-3-haiku-20240307` read its date as minor version 20240307, which
   834	    // made a model without thinking claim it. The test found that, so the bound stays.
   835	    let mut version = after
   836	        .split(|c: char| !c.is_ascii_digit())
   837	        .filter(|part| !part.is_empty())
   838	        .filter_map(|part| part.parse::<u32>().ok())
   839	        .filter(|number| *number < 100);
   840	    let Some(major) = version.next() else {
   841	        return false;
   842	    };
   843	    let minor = version.next().unwrap_or(0);
   844	    major > 3 || (major == 3 && minor >= 7)
   845	}
   846	
   847	/// Build the `additionalModelRequestFields` that ask Claude for extended thinking.
   848	///
   849	/// `None` means rho asks for nothing: no effort, `Off`, or a model that cannot think.
   850	fn build_thinking_fields(request: &CompletionRequest) -> Option<Document> {
   851	    let budget = request.reasoning?.budget_tokens()?;
   852	    if !model_supports_thinking(&request.model) {
   853	        return None;
   854	    }
   855	    let thinking = HashMap::from([
   856	        ("type".to_string(), Document::String("enabled".to_string())),
   857	        (
   858	            "budget_tokens".to_string(),
   859	            Document::Number(Number::PosInt(u64::from(budget))),
   860	        ),
   861	    ]);
   862	    Some(Document::Object(HashMap::from([(
   863	        "thinking".to_string(),
   864	        Document::Object(thinking),
   865	    )])))
   866	}
   867	
   868	/// The head room rho leaves for the answer above a thinking budget.
   869	///
   870	/// Anthropic rejects a request whose `max_tokens` is not above `budget_tokens`, and rho
   871	/// sends no `max_tokens` of its own, so the SDK default would sit below the budget.
   872	const ANSWER_HEAD_ROOM: u32 = 4096;
   873	
   874	fn build_inference_config(
   875	    request: &CompletionRequest,
   876	) -> Option<aws_sdk_bedrockruntime::types::InferenceConfiguration> {
   877	    // A thinking budget changes both numbers, so it is read first. See section 9 rules 2
   878	    // and 3: the budget needs room above it, and Anthropic refuses a stated temperature
   879	    // while it thinks.
   880	    let budget = match build_thinking_fields(request) {
   881	        Some(_) => request.reasoning.and_then(|effort| effort.budget_tokens()),
   882	        None => None,
   883	    };
   884	    if budget.is_none() && request.max_tokens.is_none() && request.temperature.is_none() {
   885	        return None;
   886	    }
   887	    let mut builder = aws_sdk_bedrockruntime::types::InferenceConfiguration::builder();
   888	    match (budget, request.max_tokens) {
   889	        // Rule 2. Keep the caller's number when it already clears the budget.
   890	        (Some(budget), Some(max_tokens)) if max_tokens > budget => {
   891	            builder = builder.max_tokens(max_tokens as i32);
   892	        }
   893	        (Some(budget), _) => {
   894	            builder = builder.max_tokens((budget + ANSWER_HEAD_ROOM) as i32);
   895	        }
   896	        (None, Some(max_tokens)) => {
   897	            builder = builder.max_tokens(max_tokens as i32);
   898	        }
   899	        (None, None) => {}
   900	    }

