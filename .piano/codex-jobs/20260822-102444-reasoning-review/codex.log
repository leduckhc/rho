   453	            let mut state = BedrockMapState::for_model(model_id);
   454	            let mut deferred_done: Option<StreamEvent> = None;
   455	            loop {
   456	                let next = tokio::select! {
   457	                    biased;
   458	                    () = cancel.cancelled() => break,
   459	                    received = receiver.recv() => received,
   460	                };
