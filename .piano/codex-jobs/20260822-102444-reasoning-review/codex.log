   352	/// Run the CLI. Return the process exit code.
   353	pub async fn run(cli: Cli) -> i32 {
   354	    match &cli.command {
   355	        Some(Command::Run { prompt }) => run_headless(&cli, prompt.clone()).await,
   356	        None => run_interactive(&cli).await,
   357	    }
   358	}
   359	
   360	/// Run one prompt headless. Print the answer to stdout. Print diagnostics to
   361	/// stderr. Return a non-zero code on failure.
   362	async fn run_headless(cli: &Cli, prompt: String) -> i32 {
   363	    // The configuration loads once, here, before a session exists.
   364	    let loaded = match load_config(cli) {
   365	        Ok(loaded) => loaded,
   366	        Err(error) => return fail(error),
   367	    };
   368	    let config = match build_config(&loaded) {
   369	        Ok(config) => config,
   370	        Err(error) => return fail(error),
   371	    };
   372	    // Hold `_tasks` and `_extras` for the whole run. Dropping the task registry kills
   373	    // every background task, and dropping the MCP pool stops every server, so an early
   374	    // drop would end work the model is still waiting on.
   375	    let (session, _tasks, extras) = match build_session(cli, &loaded, config).await {
   376	        Ok(triple) => triple,
   377	        Err(error) => return fail(error),
   378	    };
   379	    for notice in &extras.notices {
   380	        eprintln!("rho: {notice}");
   381	    }
   382	    let _extras = extras;
   383	
   384	    let cancel = CancelToken::new();
   385	    let mut events = session.prompt(vec![ContentBlock::Text { text: prompt }], cancel);
   386	    let mut stdout = std::io::stdout();
   387	    let mut failed = false;
   388	    // A run may span several turns, because a turn can call tools. Each turn is a
   389	    // separate block of prose, so separate them. Without this, the last word of one
   390	    // turn runs into the first word of the next.
   391	    let mut wrote_text = false;
   392	    let mut turn_pending = false;
   393	    // A leading `<thinking>` tag is the model's reasoning, not the answer. Without this
   394	    // the headless path printed the tag as the answer, while the TUI did not. The splitter
   395	    // starts fresh for each text block, exactly as the TUI does.
   396	    let mut splitter = rho_core::ThinkingSplitter::new();
   397	    let show_reasoning = reasoning_is_shown(loaded.reasoning);
   398	
   399	    while let Some(item) = events.next().await {
   400	        match item {
   401	            Ok(AgentEvent::Stream(StreamEvent::TextStart { .. })) => {
   402	                splitter = rho_core::ThinkingSplitter::new();
   403	            }
   404	            Ok(AgentEvent::Stream(StreamEvent::TextDelta { delta, .. })) => {
   405	                let split = split_run_delta(&mut splitter, &delta);
   406	                if show_reasoning && !split.reasoning.is_empty() {
   407	                    // stderr, so a pipe on stdout still holds the answer alone.
   408	                    eprint!("{}", split.reasoning);
   409	                }
   410	                if split.answer.is_empty() {
   411	                    continue;
   412	                }
   413	                if turn_pending {
   414	                    let _ = writeln!(stdout);
   415	                    turn_pending = false;
   416	                }
   417	                let _ = write!(stdout, "{}", split.answer);
   418	                let _ = stdout.flush();
   419	                wrote_text = true;
   420	            }
   421	            // A structured reasoning block, from a provider rho asked to think.
   422	            Ok(AgentEvent::Stream(StreamEvent::ThinkingDelta { delta, .. })) => {
   423	                if show_reasoning {
   424	                    eprint!("{delta}");
   425	                }
   426	            }
   427	            Ok(AgentEvent::TurnEnd { .. }) => {
   428	                // Mark a break, but write it only when more prose actually follows.
   429	                // So a run never ends with a stray blank line.
   430	                if wrote_text {
   431	                    turn_pending = true;
   432	                }
   433	            }
   434	            Ok(AgentEvent::AgentEnd { stop_reason }) => {
   435	                tracing::info!(?stop_reason, "run ended");
   436	            }
   437	            Ok(_) => {}
   438	            Err(error) => {
   439	                eprintln!("rho: {error}");
   440	                failed = true;
   441	                break;
   442	            }
   443	        }
   444	    }
   445	    let _ = writeln!(stdout);
   446	
   447	    if failed { EXIT_FAILURE } else { 0 }
   448	}
