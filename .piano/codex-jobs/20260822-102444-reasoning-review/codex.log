     8	use rho_core::{ContentBlock, ProviderState, ReasoningOwner, SessionLog};
     9	
    10	/// A writer that collects every log byte into a shared buffer.
    11	#[derive(Clone)]
    12	struct BufferWriter(Arc<Mutex<Vec<u8>>>);
    13	
    14	impl std::io::Write for BufferWriter {
    15	    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
    16	        self.0.lock().unwrap().extend_from_slice(buf);
    17	        Ok(buf.len())
    18	    }
    19	    fn flush(&mut self) -> std::io::Result<()> {
    20	        Ok(())
    21	    }
    22	}
    23	
    24	impl<'a> tracing_subscriber::fmt::MakeWriter<'a> for BufferWriter {
    25	    type Writer = BufferWriter;
    26	    fn make_writer(&'a self) -> Self::Writer {
    27	        self.clone()
    28	    }
    29	}
    30	
