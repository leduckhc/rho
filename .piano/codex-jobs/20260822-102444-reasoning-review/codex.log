   181	    #[test]
   182	    fn the_budget_ladder_only_grows() {
   183	        let ladder = [
   184	            ReasoningEffort::Low,
   185	            ReasoningEffort::Medium,
   186	            ReasoningEffort::High,
   187	            ReasoningEffort::XHigh,
   188	        ];
   189	        let budgets: Vec<u32> = ladder
   190	            .iter()
   191	            .map(|effort| effort.budget_tokens().expect("a level has a budget"))
   192	            .collect();
   193	        for pair in budgets.windows(2) {
   194	            assert!(pair[1] > pair[0], "the ladder only grows: {budgets:?}");
   195	        }
   196	        // Anthropic refuses a budget under 1024, so the bottom rung must clear it.
   197	        assert!(budgets[0] >= 1024, "the lowest budget is at least 1024");
   198	    }
