   631	/// Build the SDK message list from the normalised messages. Sprint 1 sends text
   632	/// and tool calls. See `SPEC-provider-interface` section 8 for the out-of-scope block kinds.
   633	pub fn build_messages(messages: &[Message]) -> Vec<aws_sdk_bedrockruntime::types::Message> {
   634	    // Kept for the contract suite, which builds messages with no model in hand. A reasoning
   635	    // payload needs the model, so a caller that replays uses `build_messages_for_model`.
   636	    build_messages_for_model(messages, "")
   637	}
   638	
   639	/// Build the request messages for one model. The model decides whether a stored reasoning
   640	/// payload may travel, per rule 8.
   641	pub fn build_messages_for_model(
   642	    messages: &[Message],
   643	    model: &str,
   644	) -> Vec<aws_sdk_bedrockruntime::types::Message> {
   645	    use aws_sdk_bedrockruntime::types::{
   646	        ContentBlock as SdkBlock, ConversationRole, Message as SdkMessage, ToolResultBlock,
   647	        ToolResultContentBlock, ToolUseBlock,
   648	    };
   649	    use rho_core::ContentBlock;
   650	
   651	    // Collect the blocks per role, merging a run of messages that share a role.
   652	    //
   653	    // Converse requires strictly alternating roles. `rho-core` records one
   654	    // `Role::Tool` message per tool result, and Bedrock has no tool role, so every
   655	    // result maps to `user`. Two tool calls in one turn therefore produced two
   656	    // consecutive user messages, and Bedrock answered 400.
   657	    //
   658	    // One tool call worked, which is why the unit tests and the first live check both
   659	    // passed. A live run with two calls found it.
   660	    //
   661	    // Merging is also what Bedrock wants: all tool results for one turn belong in a
   662	    // single user message.
   663	    let mut grouped: Vec<(ConversationRole, Vec<SdkBlock>)> = Vec::new();
   664	    for message in messages {
   665	        let role = match message.role {
   666	            Role::User | Role::Tool => ConversationRole::User,
   667	            Role::Assistant => ConversationRole::Assistant,
   668	        };
   669	        let mut blocks: Vec<SdkBlock> = Vec::new();
   670	        for block in &message.content {
   671	            match block {
   672	                ContentBlock::Text { text } => {
   673	                    blocks.push(SdkBlock::Text(text.clone()));
   674	                }
   675	                ContentBlock::ToolCall {
   676	                    id,
   677	                    name,
   678	                    arguments,
   679	                    // Bedrock binds no replay payload to a call. Gemini does, and that crate
   680	                    // reads this field without any change to shared code.
   681	                    state: _,
   682	                } => {
   683	                    if let Ok(tool_use) = ToolUseBlock::builder()
   684	                        .tool_use_id(id.clone())
   685	                        .name(name.clone())
   686	                        .input(json_to_document(arguments))
   687	                        .build()
   688	                    {
   689	                        blocks.push(SdkBlock::ToolUse(tool_use));
   690	                    }
   691	                }
   692	                ContentBlock::ToolResult {
   693	                    tool_call_id,
   694	                    content,
   695	                    is_error,
   696	                } => {
   697	                    let mut result = ToolResultBlock::builder()
   698	                        .tool_use_id(tool_call_id.clone())
   699	                        .status(if *is_error {
   700	                            aws_sdk_bedrockruntime::types::ToolResultStatus::Error
   701	                        } else {
   702	                            aws_sdk_bedrockruntime::types::ToolResultStatus::Success
   703	                        });
   704	                    for inner in content {
   705	                        if let ContentBlock::Text { text } = inner {
   706	                            result = result.content(ToolResultContentBlock::Text(text.clone()));
   707	                        }
   708	                    }
   709	                    if let Ok(result) = result.build() {
   710	                        blocks.push(SdkBlock::ToolResult(result));
   711	                    }
   712	                }
   713	                // A trace is for the reader, and it never reaches a provider. That is the
   714	                // whole point of the split, and the type enforces it here.
   715	                ContentBlock::ReasoningTrace { .. } => {}
   716	                // A replay block travels only when the payload is ours and the model still
   717	                // matches. Otherwise it is dropped in this named arm, never by `_ => {}`.
   718	                ContentBlock::ReasoningReplay { text, state } => {
   719	                    if let Some(reasoning) = replay_block(text, state, model) {
   720	                        blocks.push(SdkBlock::ReasoningContent(reasoning));
   721	                    }
   722	                }
   723	                // Image input in a request is out of scope for sprint 1. Drop it in a named
   724	                // arm, so a new block kind cannot hide behind a wildcard.
   725	                ContentBlock::Image { .. } => {}
   726	            }
   727	        }
   728	        if blocks.is_empty() {
   729	            continue;
   730	        }
   731	        match grouped.last_mut() {
   732	            Some((last_role, last_blocks)) if *last_role == role => {
   733	                last_blocks.extend(blocks);
   734	            }
   735	            _ => grouped.push((role, blocks)),
   736	        }
   737	    }
   738	
   739	    let mut out = Vec::new();
   740	    for (role, blocks) in grouped {
   741	        let mut builder = SdkMessage::builder().role(role);
   742	        for block in blocks {
   743	            builder = builder.content(block);
   744	        }
   745	        if let Ok(message) = builder.build() {
   746	            out.push(message);
   747	        }
   748	    }
   749	    out
   750	}
