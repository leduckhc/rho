   697	    /// Build the next request from the current context. The system prompt and
   698	    /// the tool list form the stable prefix. The messages grow by appending.
   699	    async fn build_request(&self) -> CompletionRequest {
   700	        let context = self.inner.context.lock().await;
   701	        CompletionRequest {
   702	            model: self.inner.config.model.clone(),
   703	            system: context.system().map(str::to_string),
   704	            messages: context.messages().to_vec(),
   705	            tools: self.inner.tools.specs(),
   706	            max_tokens: None,
   707	            temperature: None,
   708	            reasoning: self.inner.config.reasoning_effort,
   709	        }
   710	    }
   711	
   712	    /// Send one event. Return `Err` when the caller dropped the receiver.
   713	    async fn emit(&self, event: AgentEvent) -> Result<(), ()> {
   714	        self.tx.send(Ok(event)).await.map_err(|_| ())
   715	    }
   716	}
   717	
   718	/// The result of running one or more tool calls.
   719	///
   720	/// There is deliberately no `Failed` variant. A tool failure is a result that goes
   721	/// back to the model, not an end to the run. Only a transport or provider fault
   722	/// ends a run. See the tool-error branch in `dispatch_one`.
   723	enum DispatchOutcome {
   724	    /// The loop may run the next turn.
   725	    Continue,
   726	    /// The caller cancelled the run.
   727	    Canceled,
   728	    /// The caller dropped the event stream.
   729	    Closed,
   730	}
